+
+
+/*  GIMPhoto: effect rows
+ *
+ *  Like Photoshop's Layers panel, a layer with filters gets child rows: an
+ *  "Effects" row and one row per filter, each with an eye that turns that
+ *  filter (or, on "Effects", all of them) on or off. Collapsed by default;
+ *  the expanded state is remembered per drawable.
+ *
+ *  Each effect row stores its layer's own view renderer, so all the code
+ *  that reads a row as "an item" keeps seeing the layer (clicking an effect
+ *  row selects its layer, as in Photoshop). What an effect row must not do
+ *  is handled here: the item cells (eye, lock, thumbnail, editable name) are
+ *  hidden on it, its own eye toggles the filter, it is not a drop target,
+ *  and double-clicking it edits the effect instead of the layer.
+ *
+ *  Group layers keep GIMP's fx popover only: their child rows are layers.
+ */
+
+#define EFFECTS_EXPANDED_KEY "gimphoto-effects-expanded"
+#define LAYER_STYLE_PREFIX   "Layer Style: "
+
+typedef struct
+{
+  const gchar *label;
+  const gchar *procedure;
+} GimpEffectProcedure;
+
+/*  the Layer Style plug-in's procedure for each of its effects  */
+static const GimpEffectProcedure effect_procedures[] =
+{
+  { "Bevel & Emboss",   "layer-style-bevel"            },
+  { "Stroke",           "layer-style-stroke"           },
+  { "Inner Shadow",     "layer-style-inner-shadow"     },
+  { "Inner Glow",       "layer-style-inner-glow"       },
+  { "Color Overlay",    "layer-style-color-overlay"    },
+  { "Gradient Overlay", "layer-style-gradient-overlay" },
+  { "Pattern Overlay",  "layer-style-pattern-overlay"  },
+  { "Outer Glow",       "layer-style-outer-glow"       },
+  { "Drop Shadow",      "layer-style-drop-shadow"      },
+};
+
+static GimpDrawable *
+gimp_drawable_tree_view_iter_drawable (GimpDrawableTreeView *view,
+                                       GtkTreeIter          *iter)
+{
+  GimpContainerTreeStore *store;
+  GimpViewRenderer       *renderer;
+  GimpDrawable           *drawable = NULL;
+
+  store    = GIMP_CONTAINER_TREE_STORE (GIMP_CONTAINER_TREE_VIEW (view)->model);
+  renderer = gimp_container_tree_store_get_renderer (store, iter);
+
+  if (renderer)
+    {
+      if (GIMP_IS_DRAWABLE (renderer->viewable))
+        drawable = GIMP_DRAWABLE (renderer->viewable);
+
+      g_object_unref (renderer);
+    }
+
+  return drawable;
+}
+
+static gboolean
+gimp_drawable_tree_view_is_effect_iter (GimpDrawableTreeView *view,
+                                        GtkTreeIter          *iter)
+{
+  gboolean effect_row = FALSE;
+
+  gtk_tree_model_get (GIMP_CONTAINER_TREE_VIEW (view)->model, iter,
+                      view->priv->model_column_effect_row, &effect_row,
+                      -1);
+
+  return effect_row;
+}
+
+static gboolean
+gimp_drawable_tree_view_is_effect_path (GimpDrawableTreeView *view,
+                                        GtkTreePath          *path)
+{
+  GtkTreeIter iter;
+
+  return (gtk_tree_model_get_iter (GIMP_CONTAINER_TREE_VIEW (view)->model,
+                                   &iter, path) &&
+          gimp_drawable_tree_view_is_effect_iter (view, &iter));
+}
+
+static const gchar *
+gimp_drawable_tree_view_effect_label (GimpFilter *filter)
+{
+  const gchar *name = gimp_object_get_name (filter);
+
+  if (! name)
+    return "";
+
+  if (g_str_has_prefix (name, LAYER_STYLE_PREFIX))
+    return name + strlen (LAYER_STYLE_PREFIX);
+
+  return name;
+}
+
+/*  the filters listed as effects, one row each: first the Layer Style
+ *  effects in Photoshop's order (one row per effect, even when it is drawn
+ *  by more than one filter, as a centered stroke is), then any other
+ *  non-temporary filter in GIMP's order
+ */
+static GList *
+gimp_drawable_tree_view_effect_filters (GimpDrawable *drawable)
+{
+  GList *all     = NULL;
+  GList *filters = NULL;
+  GList *list;
+  gint   i;
+
+  for (list = GIMP_LIST (gimp_drawable_get_filters (drawable))->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      if (GIMP_IS_DRAWABLE_FILTER (list->data) &&
+          ! gimp_drawable_filter_get_temporary (list->data))
+        all = g_list_prepend (all, list->data);
+    }
+
+  all = g_list_reverse (all);
+
+  for (i = 0; i < G_N_ELEMENTS (effect_procedures); i++)
+    for (list = all; list; list = g_list_next (list))
+      {
+        const gchar *name = gimp_object_get_name (list->data);
+
+        if (name && g_str_has_prefix (name, LAYER_STYLE_PREFIX) &&
+            ! strcmp (name + strlen (LAYER_STYLE_PREFIX),
+                      effect_procedures[i].label))
+          {
+            filters = g_list_prepend (filters, list->data);
+            break;
+          }
+      }
+
+  for (list = all; list; list = g_list_next (list))
+    {
+      const gchar *name = gimp_object_get_name (list->data);
+
+      if (! name || ! g_str_has_prefix (name, LAYER_STYLE_PREFIX))
+        filters = g_list_prepend (filters, list->data);
+    }
+
+  g_list_free (all);
+
+  return g_list_reverse (filters);
+}
+
+/*  every filter of the drawable that belongs to the same effect row  */
+static void
+gimp_drawable_tree_view_effect_set_active (GimpDrawable *drawable,
+                                           GimpFilter   *filter,
+                                           gboolean      active)
+{
+  const gchar *name = gimp_object_get_name (filter);
+  GList       *list;
+
+  if (! name || ! g_str_has_prefix (name, LAYER_STYLE_PREFIX))
+    {
+      gimp_filter_set_active (filter, active);
+      return;
+    }
+
+  for (list = GIMP_LIST (gimp_drawable_get_filters (drawable))->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      if (GIMP_IS_DRAWABLE_FILTER (list->data) &&
+          ! g_strcmp0 (gimp_object_get_name (list->data), name))
+        gimp_filter_set_active (list->data, active);
+    }
+}
+
+static void
+gimp_drawable_tree_view_set_effect_row (GimpDrawableTreeView *view,
+                                        GtkTreeIter          *row,
+                                        GimpViewRenderer     *renderer,
+                                        GimpFilter           *filter,
+                                        gboolean              visible)
+{
+  const gchar *label = filter ? gimp_drawable_tree_view_effect_label (filter)
+                              : _("Effects");
+
+  gtk_tree_store_set (GTK_TREE_STORE (GIMP_CONTAINER_TREE_VIEW (view)->model),
+                      row,
+                      GIMP_CONTAINER_TREE_STORE_COLUMN_RENDERER,       renderer,
+                      GIMP_CONTAINER_TREE_STORE_COLUMN_NAME,           label,
+                      GIMP_CONTAINER_TREE_STORE_COLUMN_NAME_SENSITIVE, TRUE,
+                      view->priv->model_column_item_row,               FALSE,
+                      view->priv->model_column_effect_row,             TRUE,
+                      view->priv->model_column_effect_filter,          filter,
+                      view->priv->model_column_effect_visible,         visible,
+                      view->priv->model_column_effect_icon,
+                      filter ? NULL : GIMP_ICON_EFFECT,
+                      view->priv->model_column_effect_indent,
+                      filter ? 14 : 2,
+                      -1);
+}
+
+static void
+gimp_drawable_tree_view_update_effects (GimpDrawableTreeView *view,
+                                        GimpDrawable         *drawable,
+                                        GtkTreeIter          *iter)
+{
+  GimpContainerTreeView *tree_view = GIMP_CONTAINER_TREE_VIEW (view);
+  GtkTreeModel          *model     = tree_view->model;
+  GimpContainerTreeStore *store    = GIMP_CONTAINER_TREE_STORE (model);
+  GimpViewRenderer      *renderer;
+  GList                 *filters;
+  GList                 *list;
+  GtkTreeIter            child;
+  gboolean               same     = TRUE;
+  gboolean               any_visible = FALSE;
+  gint                   n_rows;
+
+  if (gimp_viewable_get_children (GIMP_VIEWABLE (drawable)))
+    return;
+
+  filters = gimp_drawable_tree_view_effect_filters (drawable);
+
+  for (list = filters; list; list = g_list_next (list))
+    any_visible |= gimp_filter_get_active (list->data);
+
+  /*  same filters in the same order: only refresh eyes and names  */
+  n_rows = gtk_tree_model_iter_n_children (model, iter);
+
+  if (n_rows != (filters ? g_list_length (filters) + 1 : 0))
+    same = FALSE;
+
+  if (same && filters &&
+      gtk_tree_model_iter_children (model, &child, iter))
+    {
+      renderer = gimp_container_tree_store_get_renderer (store, iter);
+
+      gimp_drawable_tree_view_set_effect_row (view, &child, renderer,
+                                              NULL, any_visible);
+
+      for (list = filters;
+           list && gtk_tree_model_iter_next (model, &child);
+           list = g_list_next (list))
+        {
+          GimpFilter *row_filter = NULL;
+
+          gtk_tree_model_get (model, &child,
+                              view->priv->model_column_effect_filter, &row_filter,
+                              -1);
+
+          if (row_filter != list->data)
+            same = FALSE;
+          else
+            gimp_drawable_tree_view_set_effect_row (view, &child, renderer,
+                                                    list->data,
+                                                    gimp_filter_get_active (list->data));
+
+          g_clear_object (&row_filter);
+
+          if (! same)
+            break;
+        }
+
+      g_object_unref (renderer);
+    }
+
+  if (! same)
+    {
+      gboolean expanded;
+
+      expanded = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (drawable),
+                                                     EFFECTS_EXPANDED_KEY));
+
+      /*  removing every child collapses the row: that is not the user
+       *  collapsing it, so do not record it
+       */
+      view->priv->effects_rebuilding = TRUE;
+
+      while (gtk_tree_model_iter_children (model, &child, iter))
+        gtk_tree_store_remove (GTK_TREE_STORE (model), &child);
+
+      if (filters)
+        {
+          renderer = gimp_container_tree_store_get_renderer (store, iter);
+
+          gtk_tree_store_append (GTK_TREE_STORE (model), &child, iter);
+          gimp_drawable_tree_view_set_effect_row (view, &child, renderer,
+                                                  NULL, any_visible);
+
+          for (list = filters; list; list = g_list_next (list))
+            {
+              gtk_tree_store_append (GTK_TREE_STORE (model), &child, iter);
+              gimp_drawable_tree_view_set_effect_row (view, &child, renderer,
+                                                      list->data,
+                                                      gimp_filter_get_active (list->data));
+            }
+
+          g_object_unref (renderer);
+
+          if (expanded)
+            {
+              GtkTreePath *path = gtk_tree_model_get_path (model, iter);
+
+              gtk_tree_view_expand_row (tree_view->view, path, FALSE);
+              gtk_tree_path_free (path);
+            }
+        }
+
+      view->priv->effects_rebuilding = FALSE;
+    }
+
+  g_list_free (filters);
+}
+
+static void
+gimp_drawable_tree_view_effects_row_toggled (GtkTreeView          *tree,
+                                             GtkTreeIter          *iter,
+                                             GtkTreePath          *path,
+                                             GimpDrawableTreeView *view)
+{
+  GtkTreeModel *model = GIMP_CONTAINER_TREE_VIEW (view)->model;
+  GtkTreeIter   child;
+  GimpDrawable *drawable;
+
+  if (view->priv->effects_rebuilding                       ||
+      gimp_drawable_tree_view_is_effect_iter (view, iter)  ||
+      ! gtk_tree_model_iter_children (model, &child, iter) ||
+      ! gimp_drawable_tree_view_is_effect_iter (view, &child))
+    return;
+
+  drawable = gimp_drawable_tree_view_iter_drawable (view, iter);
+
+  if (drawable)
+    g_object_set_data (G_OBJECT (drawable), EFFECTS_EXPANDED_KEY,
+                       GINT_TO_POINTER (gtk_tree_view_row_expanded (tree, path)));
+}
+
+static void
+gimp_drawable_tree_view_effect_eye_clicked (GtkCellRendererToggle *toggle,
+                                            gchar                 *path_str,
+                                            GdkModifierType        state,
+                                            GimpDrawableTreeView  *view)
+{
+  GtkTreeModel *model = GIMP_CONTAINER_TREE_VIEW (view)->model;
+  GtkTreeIter   iter;
+  GtkTreeIter   parent;
+  GimpFilter   *filter = NULL;
+  GimpDrawable *drawable;
+
+  if (! gtk_tree_model_get_iter_from_string (model, &iter, path_str) ||
+      ! gimp_drawable_tree_view_is_effect_iter (view, &iter)         ||
+      ! gtk_tree_model_iter_parent (model, &parent, &iter))
+    return;
+
+  drawable = gimp_drawable_tree_view_iter_drawable (view, &parent);
+
+  if (! drawable)
+    return;
+
+  gtk_tree_model_get (model, &iter,
+                      view->priv->model_column_effect_filter, &filter,
+                      -1);
+
+  if (filter)
+    {
+      gimp_drawable_tree_view_effect_set_active (drawable, filter,
+                                                 ! gimp_filter_get_active (filter));
+      g_object_unref (filter);
+    }
+  else
+    {
+      /*  the "Effects" row: all of them, as GIMP's fx popover does  */
+      GList    *filters = gimp_drawable_tree_view_effect_filters (drawable);
+      GList    *list;
+      gboolean  active  = TRUE;
+
+      for (list = filters; list; list = g_list_next (list))
+        if (gimp_filter_get_active (list->data))
+          active = FALSE;
+
+      for (list = filters; list; list = g_list_next (list))
+        gimp_drawable_tree_view_effect_set_active (drawable, list->data,
+                                                   active);
+
+      g_list_free (filters);
+    }
+
+  gimp_drawable_update (drawable, 0, 0, -1, -1);
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (drawable)));
+}
+
+static void
+gimp_drawable_tree_view_effects_setup (GimpDrawableTreeView *view)
+{
+  GimpContainerTreeView *tree_view = GIMP_CONTAINER_TREE_VIEW (view);
+  GtkTreeViewColumn     *column;
+  GtkCellRenderer       *cell;
+  GList                 *cells;
+  GList                 *list;
+  gint                   pixel_icon_size = 16;
+  gint                   i;
+
+  gtk_icon_size_lookup (GTK_ICON_SIZE_MENU, &pixel_icon_size, NULL);
+
+  /*  the item's own toggles (eye in column 0, lock in column 1) are hidden
+   *  on effect rows
+   */
+  for (i = 0; i < 2; i++)
+    {
+      column = gtk_tree_view_get_column (tree_view->view, i);
+      cells  = gtk_cell_layout_get_cells (GTK_CELL_LAYOUT (column));
+
+      for (list = cells; list; list = g_list_next (list))
+        gtk_tree_view_column_add_attribute (column, list->data, "visible",
+                                            view->priv->model_column_item_row);
+
+      g_list_free (cells);
+    }
+
+  /*  ... and replaced by the effect's eye  */
+  column = gtk_tree_view_get_column (tree_view->view, 0);
+
+  view->priv->effect_eye_cell = gimp_cell_renderer_toggle_new (GIMP_ICON_VISIBLE);
+  g_object_set (view->priv->effect_eye_cell,
+                "xpad",      0,
+                "ypad",      0,
+                "icon-size", pixel_icon_size,
+                NULL);
+  gtk_tree_view_column_pack_start (column, view->priv->effect_eye_cell, FALSE);
+  gtk_tree_view_column_set_attributes (column, view->priv->effect_eye_cell,
+                                       "active",
+                                       view->priv->model_column_effect_visible,
+                                       "visible",
+                                       view->priv->model_column_effect_row,
+                                       NULL);
+  gimp_container_tree_view_add_toggle_cell (tree_view,
+                                            view->priv->effect_eye_cell);
+  g_signal_connect (view->priv->effect_eye_cell, "clicked",
+                    G_CALLBACK (gimp_drawable_tree_view_effect_eye_clicked),
+                    view);
+
+  /*  thumbnail and editable name are the layer's: hidden on effect rows,
+   *  which show an icon and the effect's name instead
+   */
+  column = tree_view->main_column;
+
+  gtk_tree_view_column_add_attribute (column, tree_view->renderer_cell,
+                                      "visible",
+                                      view->priv->model_column_item_row);
+  gtk_tree_view_column_add_attribute (column,
+                                      gimp_container_tree_view_get_name_cell (tree_view),
+                                      "visible",
+                                      view->priv->model_column_item_row);
+
+  cell = gtk_cell_renderer_pixbuf_new ();
+  gtk_tree_view_column_pack_start (column, cell, FALSE);
+  gtk_cell_layout_reorder (GTK_CELL_LAYOUT (column), cell, 0);
+  gtk_tree_view_column_set_attributes (column, cell,
+                                       "icon-name",
+                                       view->priv->model_column_effect_icon,
+                                       "visible",
+                                       view->priv->model_column_effect_row,
+                                       "xpad",
+                                       view->priv->model_column_effect_indent,
+                                       NULL);
+
+  cell = gtk_cell_renderer_text_new ();
+  g_object_set (cell, "xalign", 0.0, NULL);
+  gtk_tree_view_column_pack_start (column, cell, TRUE);
+  gtk_cell_layout_reorder (GTK_CELL_LAYOUT (column), cell, 1);
+  gtk_tree_view_column_set_attributes (column, cell,
+                                       "text",
+                                       GIMP_CONTAINER_TREE_STORE_COLUMN_NAME,
+                                       "visible",
+                                       view->priv->model_column_effect_row,
+                                       NULL);
+
+  g_signal_connect (tree_view->view, "row-expanded",
+                    G_CALLBACK (gimp_drawable_tree_view_effects_row_toggled),
+                    view);
+  g_signal_connect (tree_view->view, "row-collapsed",
+                    G_CALLBACK (gimp_drawable_tree_view_effects_row_toggled),
+                    view);
+}
+
+static void
+gimp_drawable_tree_view_item_activated (GimpContainerView *view,
+                                        GimpViewable      *viewable)
+{
+  GimpDrawableTreeView  *drawable_view = GIMP_DRAWABLE_TREE_VIEW (view);
+  GimpContainerTreeView *tree_view     = GIMP_CONTAINER_TREE_VIEW (view);
+  GdkEvent              *event         = gtk_get_current_event ();
+  GtkTreePath           *path          = NULL;
+  gdouble                x, y;
+
+  /*  "item activated" only knows the row's item, the layer: find out from
+   *  the double-click itself whether it was on one of its effect rows
+   */
+  if (event &&
+      gdk_event_get_window (event) == gtk_tree_view_get_bin_window (tree_view->view) &&
+      gdk_event_get_coords (event, &x, &y))
+    {
+      gtk_tree_view_get_path_at_pos (tree_view->view, x, y,
+                                     &path, NULL, NULL, NULL);
+    }
+
+  if (event)
+    gdk_event_free (event);
+
+  if (path && gimp_drawable_tree_view_is_effect_path (drawable_view, path))
+    {
+      GtkTreeIter  iter;
+      GimpFilter  *filter    = NULL;
+      const gchar *procedure = "layer-style-dialog";
+
+      gtk_tree_model_get_iter (tree_view->model, &iter, path);
+      gtk_tree_model_get (tree_view->model, &iter,
+                          drawable_view->priv->model_column_effect_filter, &filter,
+                          -1);
+
+      if (filter &&
+          ! g_str_has_prefix (gimp_object_get_name (filter), LAYER_STYLE_PREFIX))
+        {
+          /*  any other filter: GIMP's own Layer Effects editor  */
+          GdkRectangle rect;
+
+          gtk_tree_view_get_cell_area (tree_view->view, path,
+                                       tree_view->main_column, &rect);
+          gtk_tree_view_convert_bin_window_to_widget_coords (tree_view->view,
+                                                             rect.x, rect.y,
+                                                             &rect.x, &rect.y);
+          _gimp_drawable_tree_view_filter_editor_show (drawable_view,
+                                                       GIMP_DRAWABLE (viewable),
+                                                       &rect);
+        }
+      else
+        {
+          GimpUIManager *manager;
+          gint           i;
+
+          if (filter)
+            {
+              const gchar *label = gimp_drawable_tree_view_effect_label (filter);
+
+              for (i = 0; i < G_N_ELEMENTS (effect_procedures); i++)
+                if (! strcmp (label, effect_procedures[i].label))
+                  procedure = effect_procedures[i].procedure;
+            }
+
+          manager = gimp_editor_get_ui_manager (GIMP_EDITOR (view));
+
+          if (manager)
+            gimp_ui_manager_activate_action (manager, "plug-in", procedure);
+        }
+
+      g_clear_object (&filter);
+      gtk_tree_path_free (path);
+
+      return;
+    }
+
+  if (path)
+    gtk_tree_path_free (path);
+
+  parent_view_iface->item_activated (view, viewable);
+}
