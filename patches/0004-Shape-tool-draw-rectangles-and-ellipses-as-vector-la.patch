+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimpstrokeoptions.h"
+
+#include "path/gimpbezierstroke.h"
+#include "path/gimppath.h"
+#include "path/gimpvectorlayer.h"
+#include "path/gimpvectorlayeroptions.h"
+
+#include "widgets/gimpwidgets-utils.h"
+
+#include "display/gimpdisplay.h"
+
+#include "gimpshapeoptions.h"
+#include "gimpshapetool.h"
+#include "gimptoolcontrol.h"
+
+#include "gimp-intl.h"
+
+
+/*  the length of a cubic Bézier handle drawing a quarter circle  */
+#define KAPPA 0.5522847498
+
+
+static void   gimp_shape_tool_control        (GimpTool              *tool,
+                                              GimpToolAction         action,
+                                              GimpDisplay           *display);
+static void   gimp_shape_tool_button_press   (GimpTool              *tool,
+                                              const GimpCoords      *coords,
+                                              guint32                time,
+                                              GdkModifierType        state,
+                                              GimpButtonPressType    press_type,
+                                              GimpDisplay           *display);
+static void   gimp_shape_tool_button_release (GimpTool              *tool,
+                                              const GimpCoords      *coords,
+                                              guint32                time,
+                                              GdkModifierType        state,
+                                              GimpButtonReleaseType  release_type,
+                                              GimpDisplay           *display);
+static void   gimp_shape_tool_motion         (GimpTool              *tool,
+                                              const GimpCoords      *coords,
+                                              guint32                time,
+                                              GdkModifierType        state,
+                                              GimpDisplay           *display);
+static void   gimp_shape_tool_active_modifier_key
+                                             (GimpTool              *tool,
+                                              GdkModifierType        key,
+                                              gboolean               press,
+                                              GdkModifierType        state,
+                                              GimpDisplay           *display);
+static void   gimp_shape_tool_draw           (GimpDrawTool          *draw_tool);
+
+static void   gimp_shape_tool_get_box        (GimpShapeTool         *shape,
+                                              gdouble               *x1,
+                                              gdouble               *y1,
+                                              gdouble               *x2,
+                                              gdouble               *y2);
+static void   gimp_shape_tool_create         (GimpShapeTool         *shape,
+                                              GimpDisplay           *display);
+
+
+G_DEFINE_TYPE (GimpShapeTool, gimp_shape_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define parent_class gimp_shape_tool_parent_class
+
+
+void
+gimp_shape_tool_register (GimpToolRegisterCallback  callback,
+                          gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_SHAPE_TOOL,
+                GIMP_TYPE_SHAPE_OPTIONS,
+                gimp_shape_options_gui,
+                GIMP_CONTEXT_PROP_MASK_PATTERN,
+                "gimp-shape-tool",
+                _("Shape"),
+                _("Shape Tool: Draw rectangles and ellipses as vector layers"),
+                N_("S_hape"), NULL,
+                NULL, "gimp-shape-tool",
+                GIMP_ICON_SHAPE_SQUARE,
+                data);
+}
+
+static void
+gimp_shape_tool_class_init (GimpShapeToolClass *klass)
+{
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  tool_class->control             = gimp_shape_tool_control;
+  tool_class->button_press        = gimp_shape_tool_button_press;
+  tool_class->button_release      = gimp_shape_tool_button_release;
+  tool_class->motion              = gimp_shape_tool_motion;
+  tool_class->active_modifier_key = gimp_shape_tool_active_modifier_key;
+  tool_class->is_destructive      = FALSE;
+
+  draw_tool_class->draw           = gimp_shape_tool_draw;
+}
+
+static void
+gimp_shape_tool_init (GimpShapeTool *shape)
+{
+  GimpTool *tool = GIMP_TOOL (shape);
+
+  gimp_tool_control_set_active_modifiers (tool->control,
+                                          GIMP_TOOL_ACTIVE_MODIFIERS_SEPARATE);
+  gimp_tool_control_set_precision   (tool->control,
+                                     GIMP_CURSOR_PRECISION_PIXEL_BORDER);
+  gimp_tool_control_set_cursor      (tool->control,
+                                     GIMP_CURSOR_CROSSHAIR_SMALL);
+  gimp_tool_control_set_tool_cursor (tool->control,
+                                     GIMP_TOOL_CURSOR_NONE);
+
+  gimp_draw_tool_set_default_status (GIMP_DRAW_TOOL (tool),
+                                     _("Click-Drag to draw a shape "
+                                       "(Shift: square or circle, "
+                                       "Alt: from the center)"));
+}
+
+static void
+gimp_shape_tool_control (GimpTool       *tool,
+                         GimpToolAction  action,
+                         GimpDisplay    *display)
+{
+  switch (action)
+    {
+    case GIMP_TOOL_ACTION_PAUSE:
+    case GIMP_TOOL_ACTION_RESUME:
+      break;
+
+    case GIMP_TOOL_ACTION_HALT:
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+      tool->display = NULL;
+      break;
+
+    case GIMP_TOOL_ACTION_COMMIT:
+      break;
+    }
+
+  GIMP_TOOL_CLASS (parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_shape_tool_button_press (GimpTool            *tool,
+                              const GimpCoords    *coords,
+                              guint32              time,
+                              GdkModifierType      state,
+                              GimpButtonPressType  press_type,
+                              GimpDisplay         *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  /*  whole pixels, so straight edges are crisp  */
+  shape->start_x = shape->end_x = RINT (coords->x);
+  shape->start_y = shape->end_y = RINT (coords->y);
+  shape->state   = state;
+
+  tool->display = display;
+  gimp_tool_control_activate (tool->control);
+  gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+}
+
+static void
+gimp_shape_tool_motion (GimpTool         *tool,
+                        const GimpCoords *coords,
+                        guint32           time,
+                        GdkModifierType   state,
+                        GimpDisplay      *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+  gdouble        x1, y1, x2, y2;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  shape->end_x = RINT (coords->x);
+  shape->end_y = RINT (coords->y);
+  shape->state = state;
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+
+  gimp_shape_tool_get_box (shape, &x1, &y1, &x2, &y2);
+  gimp_tool_pop_status (tool, display);
+  gimp_tool_push_status_coords (tool, display,
+                                gimp_tool_control_get_precision (tool->control),
+                                _("Shape: "),
+                                x2 - x1, " × ", y2 - y1, NULL);
+}
+
+static void
+gimp_shape_tool_active_modifier_key (GimpTool        *tool,
+                                     GdkModifierType  key,
+                                     gboolean         press,
+                                     GdkModifierType  state,
+                                     GimpDisplay     *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  /*  Shift and Alt change the box while dragging  */
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+  shape->state = state;
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_shape_tool_button_release (GimpTool              *tool,
+                                const GimpCoords      *coords,
+                                guint32                time,
+                                GdkModifierType        state,
+                                GimpButtonReleaseType  release_type,
+                                GimpDisplay           *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  gimp_tool_control_halt (tool->control);
+  gimp_tool_pop_status (tool, display);
+
+  if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  if (release_type != GIMP_BUTTON_RELEASE_CANCEL)
+    {
+      shape->state = state;
+      gimp_shape_tool_create (shape, display);
+    }
+
+  tool->display = NULL;
+}
+
+static void
+gimp_shape_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpShapeTool    *shape   = GIMP_SHAPE_TOOL (draw_tool);
+  GimpShapeOptions *options = GIMP_SHAPE_TOOL_GET_OPTIONS (shape);
+  gdouble           x1, y1, x2, y2;
+
+  gimp_shape_tool_get_box (shape, &x1, &y1, &x2, &y2);
+
+  if (options->shape_type == GIMP_SHAPE_ELLIPSE)
+    gimp_draw_tool_add_arc (draw_tool, FALSE,
+                            x1, y1, x2 - x1, y2 - y1, 0.0, 2.0 * G_PI);
+  else
+    gimp_draw_tool_add_rectangle (draw_tool, FALSE,
+                                  x1, y1, x2 - x1, y2 - y1);
+}
+
+/*  The box the shape fills, from the drag and the modifiers.  */
+static void
+gimp_shape_tool_get_box (GimpShapeTool *shape,
+                         gdouble       *x1,
+                         gdouble       *y1,
+                         gdouble       *x2,
+                         gdouble       *y2)
+{
+  gdouble dx = shape->end_x - shape->start_x;
+  gdouble dy = shape->end_y - shape->start_y;
+
+  /*  Shift, as in Photoshop (GIMP's own "constrain" modifier is Ctrl)  */
+  if (shape->state & gimp_get_extend_selection_mask ())
+    {
+      gdouble size = MAX (fabs (dx), fabs (dy));
+
+      dx = dx < 0 ? -size : size;
+      dy = dy < 0 ? -size : size;
+    }
+
+  if (shape->state & GDK_MOD1_MASK)
+    {
+      *x1 = shape->start_x - fabs (dx);
+      *x2 = shape->start_x + fabs (dx);
+      *y1 = shape->start_y - fabs (dy);
+      *y2 = shape->start_y + fabs (dy);
+    }
+  else
+    {
+      *x1 = MIN (shape->start_x, shape->start_x + dx);
+      *x2 = MAX (shape->start_x, shape->start_x + dx);
+      *y1 = MIN (shape->start_y, shape->start_y + dy);
+      *y2 = MAX (shape->start_y, shape->start_y + dy);
+    }
+}
+
+static GimpCoords
+point (gdouble x,
+       gdouble y)
+{
+  GimpCoords coords = GIMP_COORDS_DEFAULT_VALUES;
+
+  coords.x = x;
+  coords.y = y;
+
+  return coords;
+}
+
+/*  A rectangle, its corners rounded by radius.  */
+static GimpStroke *
+rectangle_stroke (gdouble x1,
+                  gdouble y1,
+                  gdouble x2,
+                  gdouble y2,
+                  gdouble radius)
+{
+  GimpStroke *stroke;
+  GimpCoords  a, b, c;
+  gdouble     r = MIN (radius, MIN (x2 - x1, y2 - y1) / 2.0);
+  gdouble     k = r * KAPPA;
+
+  if (r <= 0.0)
+    {
+      a = point (x1, y1);
+      stroke = gimp_bezier_stroke_new_moveto (&a);
+      a = point (x2, y1);
+      gimp_bezier_stroke_lineto (stroke, &a);
+      a = point (x2, y2);
+      gimp_bezier_stroke_lineto (stroke, &a);
+      a = point (x1, y2);
+      gimp_bezier_stroke_lineto (stroke, &a);
+      gimp_stroke_close (stroke);
+
+      return stroke;
+    }
+
+  a = point (x1 + r, y1);
+  stroke = gimp_bezier_stroke_new_moveto (&a);
+
+  a = point (x2 - r, y1);
+  gimp_bezier_stroke_lineto (stroke, &a);
+  a = point (x2 - r + k, y1); b = point (x2, y1 + r - k); c = point (x2, y1 + r);
+  gimp_bezier_stroke_cubicto (stroke, &a, &b, &c);
+
+  a = point (x2, y2 - r);
+  gimp_bezier_stroke_lineto (stroke, &a);
+  a = point (x2, y2 - r + k); b = point (x2 - r + k, y2); c = point (x2 - r, y2);
+  gimp_bezier_stroke_cubicto (stroke, &a, &b, &c);
+
+  a = point (x1 + r, y2);
+  gimp_bezier_stroke_lineto (stroke, &a);
+  a = point (x1 + r - k, y2); b = point (x1, y2 - r + k); c = point (x1, y2 - r);
+  gimp_bezier_stroke_cubicto (stroke, &a, &b, &c);
+
+  a = point (x1, y1 + r);
+  gimp_bezier_stroke_lineto (stroke, &a);
+  a = point (x1, y1 + r - k); b = point (x1 + r - k, y1); c = point (x1 + r, y1);
+  gimp_bezier_stroke_cubicto (stroke, &a, &b, &c);
+
+  gimp_stroke_close (stroke);
+
+  return stroke;
+}
+
+static void
+gimp_shape_tool_create (GimpShapeTool *shape,
+                        GimpDisplay   *display)
+{
+  GimpShapeOptions *options      = GIMP_SHAPE_TOOL_GET_OPTIONS (shape);
+  GimpPathOptions  *path_options = GIMP_PATH_OPTIONS (options);
+  GimpImage        *image        = gimp_display_get_image (display);
+  GimpContext      *context      = gimp_get_user_context (image->gimp);
+  GimpPath         *path;
+  GimpStroke       *stroke;
+  GimpVectorLayer  *layer;
+  const gchar      *name;
+  gdouble           x1, y1, x2, y2;
+
+  gimp_shape_tool_get_box (shape, &x1, &y1, &x2, &y2);
+
+  /*  a click without a drag draws nothing  */
+  if (x2 - x1 < 1.0 || y2 - y1 < 1.0)
+    return;
+
+  if (options->shape_type == GIMP_SHAPE_ELLIPSE)
+    {
+      GimpCoords center = point ((x1 + x2) / 2.0, (y1 + y2) / 2.0);
+
+      name   = C_("shape-type", "Ellipse");
+      stroke = gimp_bezier_stroke_new_ellipse (&center,
+                                               (x2 - x1) / 2.0,
+                                               (y2 - y1) / 2.0,
+                                               0.0);
+    }
+  else
+    {
+      name   = C_("shape-type", "Rectangle");
+      stroke = rectangle_stroke (x1, y1, x2, y2, options->corner_radius);
+    }
+
+  /*  one undo step, as the Paths tool's "Create New Vector Layer"  */
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_DRAWABLE, name);
+
+  path = gimp_path_new (image, name);
+  gimp_path_stroke_add (path, stroke);
+  g_object_unref (stroke);
+  gimp_image_add_path (image, path, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+  layer = gimp_vector_layer_new (image, path, context);
+  g_object_set (layer->options,
+                "enable-fill",   path_options->enable_fill,
+                "enable-stroke", path_options->enable_stroke,
+                NULL);
+
+  /*  the fill and stroke editors exist once the tool options were shown  */
+  if (path_options->fill_options)
+    gimp_config_sync (G_OBJECT (path_options->fill_options),
+                      G_OBJECT (layer->options->fill_options), 0);
+  else
+    g_object_set (layer->options->fill_options,
+                  "foreground", path_options->fill_foreground,
+                  NULL);
+
+  if (path_options->stroke_options)
+    gimp_config_sync (G_OBJECT (path_options->stroke_options),
+                      G_OBJECT (layer->options->stroke_options), 0);
+
+  gimp_image_add_layer (image, GIMP_LAYER (layer),
+                        GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+  gimp_image_undo_group_end (image);
+
+  gimp_vector_layer_refresh (layer);
+  gimp_image_flush (image);
+}
