+/*  Show only the settings of the shape being drawn.  */
+static void
+gimp_shape_options_shape_notify (GimpShapeOptions *options,
+                                 GParamSpec       *pspec,
+                                 GtkWidget        *box)
+{
+  GimpShapeType shape = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (box),
+                                                            "shape-type"));
+
+  gtk_widget_set_visible (box, options->shape_type == shape);
+}
+
+static GtkWidget *
+shape_box (GimpShapeOptions *options,
+           GtkWidget        *vbox,
+           GimpShapeType     shape)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+
+  gtk_box_pack_start (GTK_BOX (vbox), box, FALSE, FALSE, 0);
+  g_object_set_data (G_OBJECT (box), "shape-type", GINT_TO_POINTER (shape));
+  g_signal_connect_object (options, "notify::shape-type",
+                           G_CALLBACK (gimp_shape_options_shape_notify),
+                           box, 0);
+  gimp_shape_options_shape_notify (options, NULL, box);
+
+  return box;
+}
