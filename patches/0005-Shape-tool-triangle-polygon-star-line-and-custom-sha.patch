+/*  A line from the press to the release, weight pixels wide; Shift
+ *  snaps it to 45° steps, as Photoshop's Line tool does.
+ */
+static GimpStroke *
+line_stroke (GimpShapeTool *shape,
+             gdouble        weight)
+{
+  gdouble     dx     = shape->end_x - shape->start_x;
+  gdouble     dy     = shape->end_y - shape->start_y;
+  gdouble     length = sqrt (dx * dx + dy * dy);
+  gdouble     nx, ny;
+  GimpVector2 points[4];
+
+  if (length < 1.0)
+    return NULL;
+
+  if (shape->state & gimp_get_extend_selection_mask ())
+    {
+      gdouble angle = RINT (atan2 (dy, dx) / (G_PI / 4.0)) * (G_PI / 4.0);
+
+      dx = length * cos (angle);
+      dy = length * sin (angle);
+    }
+
+  /*  half the weight on each side of the line  */
+  nx = -dy / length * weight / 2.0;
+  ny =  dx / length * weight / 2.0;
+
+  points[0].x = shape->start_x + nx;      points[0].y = shape->start_y + ny;
+  points[1].x = shape->start_x + dx + nx; points[1].y = shape->start_y + dy + ny;
+  points[2].x = shape->start_x + dx - nx; points[2].y = shape->start_y + dy - ny;
+  points[3].x = shape->start_x - nx;      points[3].y = shape->start_y - ny;
+
+  return polygon_stroke (points, 4);
+}
