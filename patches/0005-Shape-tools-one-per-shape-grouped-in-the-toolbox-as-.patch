+/*  Unit-square path data, fitted to the box.  */
+static GimpStroke *
+path_data_stroke (const gchar *data,
+                  gdouble      x1,
+                  gdouble      y1,
+                  gdouble      x2,
+                  gdouble      y2)
+{
+  GimpStroke  *stroke = NULL;
+  gchar      **tokens = g_strsplit_set (data, " ", -1);
+  gint         i      = 0;
+
+#define NEXT_POINT(c)                                                    \
+  G_STMT_START {                                                        \
+    gdouble px = g_ascii_strtod (tokens[i++], NULL);                    \
+    gdouble py = g_ascii_strtod (tokens[i++], NULL);                    \
+    c = point (x1 + px * (x2 - x1), y1 + py * (y2 - y1));              \
+  } G_STMT_END
+
+  while (tokens[i])
+    {
+      const gchar *cmd = tokens[i++];
+      GimpCoords   a, b, c;
+
+      if (! *cmd)
+        continue;
+
+      switch (*cmd)
+        {
+        case 'M':
+          NEXT_POINT (a);
+          if (! stroke)
+            stroke = gimp_bezier_stroke_new_moveto (&a);
+          break;
+
+        case 'L':
+          NEXT_POINT (a);
+          gimp_bezier_stroke_lineto (stroke, &a);
+          break;
+
+        case 'C':
+          NEXT_POINT (a);
+          NEXT_POINT (b);
+          NEXT_POINT (c);
+          gimp_bezier_stroke_cubicto (stroke, &a, &b, &c);
+          break;
+
+        case 'Z':
+          gimp_stroke_close (stroke);
+          break;
+        }
+    }
+
+#undef NEXT_POINT
+
+  g_strfreev (tokens);
+
+  return stroke;
+}
