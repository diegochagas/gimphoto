+/*  A regular polygon, or a star, inscribed in the box's ellipse, a point
+ *  up, as Photoshop's Polygon tool draws it.
+ */
+static GimpStroke *
+regular_polygon_stroke (gdouble  x1,
+                        gdouble  y1,
+                        gdouble  x2,
+                        gdouble  y2,
+                        gint     sides,
+                        gboolean star,
+                        gdouble  indent)
+{
+  GimpStroke  *stroke;
+  GimpVector2 *points;
+  gdouble      cx    = (x1 + x2) / 2.0;
+  gdouble      cy    = (y1 + y2) / 2.0;
+  gdouble      rx    = (x2 - x1) / 2.0;
+  gdouble      ry    = (y2 - y1) / 2.0;
+  gint         n     = MAX (sides, 3);
+  gint         steps = star ? n * 2 : n;
+  gint         i;
+
+  points = g_new (GimpVector2, steps);
+
+  for (i = 0; i < steps; i++)
+    {
+      gdouble a = -G_PI / 2.0 + i * 2.0 * G_PI / steps;
+      gdouble f = (star && i % 2) ? 1.0 - indent / 100.0 : 1.0;
+
+      points[i].x = cx + rx * f * cos (a);
+      points[i].y = cy + ry * f * sin (a);
+    }
+
+  stroke = polygon_stroke (points, steps);
+  g_free (points);
+
+  return stroke;
+}
