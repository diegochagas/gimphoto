+GType
+gimp_custom_shape_get_type (void)
+{
+  static const GEnumValue values[] =
+  {
+    { GIMP_CUSTOM_SHAPE_HEART,         "GIMP_CUSTOM_SHAPE_HEART",         "heart"         },
+    { GIMP_CUSTOM_SHAPE_STAR,          "GIMP_CUSTOM_SHAPE_STAR",          "star"          },
+    { GIMP_CUSTOM_SHAPE_ARROW,         "GIMP_CUSTOM_SHAPE_ARROW",         "arrow"         },
+    { GIMP_CUSTOM_SHAPE_SPEECH_BUBBLE, "GIMP_CUSTOM_SHAPE_SPEECH_BUBBLE", "speech-bubble" },
+    { GIMP_CUSTOM_SHAPE_BURST,         "GIMP_CUSTOM_SHAPE_BURST",         "burst"         },
+    { GIMP_CUSTOM_SHAPE_CHECK_MARK,    "GIMP_CUSTOM_SHAPE_CHECK_MARK",    "check-mark"    },
+    { GIMP_CUSTOM_SHAPE_LIGHTNING,     "GIMP_CUSTOM_SHAPE_LIGHTNING",     "lightning"     },
+    { GIMP_CUSTOM_SHAPE_CROSS,         "GIMP_CUSTOM_SHAPE_CROSS",         "cross"         },
+    { 0, NULL, NULL }
+  };
+
+  static const GimpEnumDesc descs[] =
+  {
+    { GIMP_CUSTOM_SHAPE_HEART,         NC_("custom-shape", "Heart"),         NULL },
+    { GIMP_CUSTOM_SHAPE_STAR,          NC_("custom-shape", "Star"),          NULL },
+    { GIMP_CUSTOM_SHAPE_ARROW,         NC_("custom-shape", "Arrow"),         NULL },
+    { GIMP_CUSTOM_SHAPE_SPEECH_BUBBLE, NC_("custom-shape", "Speech Bubble"), NULL },
+    { GIMP_CUSTOM_SHAPE_BURST,         NC_("custom-shape", "Burst"),         NULL },
+    { GIMP_CUSTOM_SHAPE_CHECK_MARK,    NC_("custom-shape", "Check Mark"),    NULL },
+    { GIMP_CUSTOM_SHAPE_LIGHTNING,     NC_("custom-shape", "Lightning"),     NULL },
+    { GIMP_CUSTOM_SHAPE_CROSS,         NC_("custom-shape", "Cross"),         NULL },
+    { 0, NULL, NULL }
+  };
+
+  static GType type = 0;
+
+  if (G_UNLIKELY (! type))
+    {
+      type = g_enum_register_static ("GimpCustomShape", values);
+      gimp_type_set_translation_context (type, "custom-shape");
+      gimp_enum_set_value_descriptions (type, descs);
+    }
+
+  return type;
+}
