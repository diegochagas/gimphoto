From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diego Chagas <drochachagas@gmail.com>
Date: Tue, 6 Oct 2026 09:40:50 -0300
Subject: [PATCH] Smart Objects: right-click menu entries, link layer corners
 in the PDB

The Layers dock's right-click menu gets Photoshop's Smart Object commands
(Convert to Smart Object, Edit Contents, Replace Contents) from GIMPhoto's
smart-objects plug-in.

New PDB procedure gimp-link-layer-get-corners: where the four corners of a
link layer's file are on the canvas after its non-destructive transforms,
and that file's size, so the plug-in can write a smart object's transform
into a PSD.

diff --git a/app/pdb/internal-procs.c b/app/pdb/internal-procs.c
index 5ae707bbc2..fde7d4a73a 100644
--- a/app/pdb/internal-procs.c
+++ b/app/pdb/internal-procs.c
@@ -30,7 +30,7 @@
 #include "internal-procs.h"
 
 
-/* 786 procedures registered total */
+/* 787 procedures registered total */
 
 void
 internal_procs_init (GimpPDB *pdb)
diff --git a/app/pdb/link-layer-cmds.c b/app/pdb/link-layer-cmds.c
index 15cc6ce718..5596601d19 100644
--- a/app/pdb/link-layer-cmds.c
+++ b/app/pdb/link-layer-cmds.c
@@ -25,6 +25,8 @@
 
 #include <gdk-pixbuf/gdk-pixbuf.h>
 
+#include "libgimpmath/gimpmath.h"
+
 #include "libgimpbase/gimpbase.h"
 
 #include "pdb-types.h"
@@ -199,6 +201,69 @@ link_layer_get_mime_type_invoker (GimpProcedure         *procedure,
   return return_vals;
 }
 
+static GimpValueArray *
+link_layer_get_corners_invoker (GimpProcedure         *procedure,
+                                Gimp                  *gimp,
+                                GimpContext           *context,
+                                GimpProgress          *progress,
+                                const GimpValueArray  *args,
+                                GError               **error)
+{
+  gboolean success = TRUE;
+  GimpValueArray *return_vals;
+  GimpLinkLayer *layer;
+  gsize num_corners = 0;
+  gdouble *corners = NULL;
+  gint width = 0;
+  gint height = 0;
+
+  layer = g_value_get_object (gimp_value_array_index (args, 0));
+
+  if (success)
+    {
+      GimpLink *link = gimp_link_layer_get_link (layer);
+
+      if (link)
+        {
+          GimpMatrix3 matrix;
+          gint        x;
+          gint        y;
+          gint        i;
+
+          gimp_link_get_size (link, &width, &height);
+
+          /* untransformed: the image sits at the layer's offsets */
+          if (! gimp_link_layer_get_transform (layer, &matrix, &x, &y, NULL))
+            gimp_item_get_offset (GIMP_ITEM (layer), &x, &y);
+
+          num_corners = 8;
+          corners     = g_new (gdouble, num_corners);
+
+          for (i = 0; i < 4; i++)
+            gimp_matrix3_transform_point (&matrix,
+                                          x + (i == 1 || i == 2 ? width  : 0),
+                                          y + (i >= 2           ? height : 0),
+                                          &corners[2 * i], &corners[2 * i + 1]);
+        }
+      else
+        {
+          success = FALSE;
+        }
+    }
+
+  return_vals = gimp_procedure_get_return_values (procedure, success,
+                                                  error ? *error : NULL);
+
+  if (success)
+    {
+      gimp_value_take_double_array (gimp_value_array_index (return_vals, 1), corners, num_corners);
+      g_value_set_int (gimp_value_array_index (return_vals, 2), width);
+      g_value_set_int (gimp_value_array_index (return_vals, 3), height);
+    }
+
+  return return_vals;
+}
+
 void
 register_link_layer_procs (GimpPDB *pdb)
 {
@@ -334,4 +399,44 @@ register_link_layer_procs (GimpPDB *pdb)
                                                            GIMP_PARAM_READWRITE));
   gimp_pdb_register_procedure (pdb, procedure);
   g_object_unref (procedure);
+
+  /*
+   * gimp-link-layer-get-corners
+   */
+  procedure = gimp_procedure_new (link_layer_get_corners_invoker, FALSE);
+  gimp_object_set_static_name (GIMP_OBJECT (procedure),
+                               "gimp-link-layer-get-corners");
+  gimp_procedure_set_static_help (procedure,
+                                  "Get where the corners of the monitored file are on the canvas.",
+                                  "This procedure returns the canvas coordinates of the four corners of the monitored file's image (top-left, top-right, bottom-right, bottom-left), after the link layer's non-destructive transforms (move, scale, rotate, shear, perspective), and the size of that image. For an untransformed link layer, the corners are the layer's bounds.",
+                                  NULL);
+  gimp_procedure_set_static_attribution (procedure,
+                                         "GIMPhoto",
+                                         "GIMPhoto",
+                                         "2026");
+  gimp_procedure_add_argument (procedure,
+                               gimp_param_spec_link_layer ("layer",
+                                                           "layer",
+                                                           "The link layer",
+                                                           FALSE,
+                                                           GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (procedure,
+                                   gimp_param_spec_double_array ("corners",
+                                                                 "corners",
+                                                                 "x, y of the four corners: top-left, top-right, bottom-right, bottom-left",
+                                                                 GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (procedure,
+                                   g_param_spec_int ("width",
+                                                     "width",
+                                                     "The width of the monitored image",
+                                                     G_MININT32, G_MAXINT32, 0,
+                                                     GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (procedure,
+                                   g_param_spec_int ("height",
+                                                     "height",
+                                                     "The height of the monitored image",
+                                                     G_MININT32, G_MAXINT32, 0,
+                                                     GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, procedure);
+  g_object_unref (procedure);
 }
