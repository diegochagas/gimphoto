 gboolean       gimp_link_layer_set_file      (GimpLinkLayer *layer,
                                               GFile         *file);
 gchar*         gimp_link_layer_get_mime_type (GimpLinkLayer *layer);
+gdouble*       gimp_link_layer_get_corners   (GimpLinkLayer *layer,
+                                              gsize         *num_corners,
+                                              gint          *width,
+                                              gint          *height);
 
 
 G_END_DECLS
