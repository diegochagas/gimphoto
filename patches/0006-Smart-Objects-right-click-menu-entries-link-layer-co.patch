diff --git a/libgimp/gimplinklayer_pdb.c b/libgimp/gimplinklayer_pdb.c
index d97175e6dc..2ad2585bb4 100644
--- a/libgimp/gimplinklayer_pdb.c
+++ b/libgimp/gimplinklayer_pdb.c
@@ -203,3 +203,58 @@ gimp_link_layer_get_mime_type (GimpLinkLayer *layer)
 
   return mimetype;
 }
+
+/**
+ * gimp_link_layer_get_corners:
+ * @layer: The link layer.
+ * @num_corners: (out): The number of coordinates (8).
+ * @width: (out): The width of the monitored image.
+ * @height: (out): The height of the monitored image.
+ *
+ * Get where the corners of the monitored file are on the canvas.
+ *
+ * This procedure returns the canvas coordinates of the four corners of
+ * the monitored file's image (top-left, top-right, bottom-right,
+ * bottom-left), after the link layer's non-destructive transforms
+ * (move, scale, rotate, shear, perspective), and the size of that
+ * image. For an untransformed link layer, the corners are the layer's
+ * bounds.
+ *
+ * Returns: (array length=num_corners) (element-type gdouble) (transfer full):
+ *          x, y of the four corners: top-left, top-right, bottom-right, bottom-left.
+ *          The returned value must be freed with g_free().
+ *
+ * Since: 3.2
+ **/
+gdouble *
+gimp_link_layer_get_corners (GimpLinkLayer *layer,
+                             gsize         *num_corners,
+                             gint          *width,
+                             gint          *height)
+{
+  GimpValueArray *args;
+  GimpValueArray *return_vals;
+  gdouble *corners = NULL;
+
+  args = gimp_value_array_new_from_types (NULL,
+                                          GIMP_TYPE_LINK_LAYER, layer,
+                                          G_TYPE_NONE);
+
+  return_vals = _gimp_pdb_run_procedure_array (gimp_get_pdb (),
+                                               "gimp-link-layer-get-corners",
+                                               args);
+  gimp_value_array_unref (args);
+
+  *num_corners = 0;
+
+  if (GIMP_VALUES_GET_ENUM (return_vals, 0) == GIMP_PDB_SUCCESS)
+    {
+      corners = GIMP_VALUES_DUP_DOUBLE_ARRAY (return_vals, 1, num_corners);
+      *width = GIMP_VALUES_GET_INT (return_vals, 2);
+      *height = GIMP_VALUES_GET_INT (return_vals, 3);
+    }
+
+  gimp_value_array_unref (return_vals);
+
+  return corners;
+}
diff --git a/libgimp/gimplinklayer_pdb.h b/libgimp/gimplinklayer_pdb.h
index 52fac573f7..6c2c7dccee 100644
--- a/libgimp/gimplinklayer_pdb.h
