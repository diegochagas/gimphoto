-@headers = qw("core/gimplink.h"
+sub link_layer_get_corners {
+    $blurb = 'Get where the corners of the monitored file are on the canvas.';
+
+    $help = <<'HELP';
+This procedure returns the canvas coordinates of the four corners of the
+monitored file's image (top-left, top-right, bottom-right, bottom-left),
+after the link layer's non-destructive transforms (move, scale, rotate,
+shear, perspective), and the size of that image. For an untransformed link
+layer, the corners are the layer's bounds.
+HELP
+
+    &contrib_pdb_misc('GIMPhoto', '', '2026', '3.2');
+
+    @inargs = (
+        { name => 'layer', type => 'link_layer',
+          desc => 'The link layer' }
+    );
+
+    @outargs = (
+        { name => 'corners', type => 'doublearray',
+          desc => 'x, y of the four corners: top-left, top-right, bottom-right, bottom-left',
+          array => { desc => 'The number of coordinates (8)' } },
+        { name => 'width', type => 'int32',
+          desc => 'The width of the monitored image' },
+        { name => 'height', type => 'int32',
+          desc => 'The height of the monitored image' }
+    );
+
+    %invoke = (
+        code => <<'CODE'
+{
+  GimpLink *link = gimp_link_layer_get_link (layer);
+
+  if (link)
+    {
+      GimpMatrix3 matrix;
+      gint        x;
+      gint        y;
+      gint        i;
+
+      gimp_link_get_size (link, &width, &height);
+
+      /* untransformed: the image sits at the layer's offsets */
+      if (! gimp_link_layer_get_transform (layer, &matrix, &x, &y, NULL))
+        gimp_item_get_offset (GIMP_ITEM (layer), &x, &y);
+
+      num_corners = 8;
+      corners     = g_new (gdouble, num_corners);
+
+      for (i = 0; i < 4; i++)
+        gimp_matrix3_transform_point (&matrix,
+                                      x + (i == 1 || i == 2 ? width  : 0),
+                                      y + (i >= 2           ? height : 0),
+                                      &corners[2 * i], &corners[2 * i + 1]);
+    }
+  else
+    {
+      success = FALSE;
+    }
+}
+CODE
+    );
+}
+
+@headers = qw("libgimpmath/gimpmath.h"
+              "core/gimplink.h"
               "core/gimplinklayer.h"
               "core/gimprasterizable.h"
               "gimppdberror.h"
@@ -201,7 +266,8 @@ CODE
 @procs = qw(link_layer_new
             link_layer_get_file
             link_layer_set_file
-            link_layer_get_mime_type);
+            link_layer_get_mime_type
+            link_layer_get_corners);
 
 %exports = (app => [@procs], lib => [@procs]);
 
