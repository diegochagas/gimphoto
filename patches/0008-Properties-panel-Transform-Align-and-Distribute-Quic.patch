+
+static void        gimp_properties_editor_set_image      (GimpImageEditor      *image_editor,
+                                                          GimpImage            *image);
+
+static void        gimp_properties_editor_image_changed  (GimpImage            *image,
+                                                          GimpPropertiesEditor *editor);
+static void        gimp_properties_editor_undo_event     (GimpImage            *image,
+                                                          GimpUndoEvent         event,
+                                                          GimpUndo             *undo,
+                                                          GimpPropertiesEditor *editor);
