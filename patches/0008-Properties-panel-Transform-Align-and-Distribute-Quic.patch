+#define GIMP_TYPE_PROPERTIES_EDITOR            (gimp_properties_editor_get_type ())
+#define GIMP_PROPERTIES_EDITOR(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_PROPERTIES_EDITOR, GimpPropertiesEditor))
