+/*  The Quick Actions: GIMPhoto plug-in procedures (actions named after
+ *  them), insensitive until the plug-in is there.
+ */
+typedef struct
+{
+  const gchar *procedure;
+  const gchar *label;
+  const gchar *tooltip;
+} QuickAction;
+
+static const QuickAction quick_actions[] =
+{
+  { "gimphoto-remove-background", N_("Remove Background"),
+    N_("Put the subject on a transparent background (AI)") },
+  { "gimphoto-select-subject",    N_("Select Subject"),
+    N_("Select the main subject of the image (AI)") }
+};
+
+#define N_QUICK_ACTIONS G_N_ELEMENTS (quick_actions)
+
+static const GimpAlignmentType align_types[] =
+{
+  GIMP_ALIGN_LEFT, GIMP_ALIGN_HCENTER, GIMP_ALIGN_RIGHT,
+  GIMP_ALIGN_TOP,  GIMP_ALIGN_VCENTER, GIMP_ALIGN_BOTTOM,
+  GIMP_DISTRIBUTE_EVEN_HORIZONTAL_GAP, GIMP_DISTRIBUTE_EVEN_VERTICAL_GAP
+};
+
+#define N_ALIGN_BUTTONS G_N_ELEMENTS (align_types)
+
+
