+
+typedef struct _GimpPropertiesEditorPrivate  GimpPropertiesEditorPrivate;
+typedef struct _GimpPropertiesEditorClass    GimpPropertiesEditorClass;
+
+/*  GIMPhoto: Photoshop's Properties panel. The selected layer's kind, its
+ *  Transform (size, position, rotation, flips), Align and Distribute for the
+ *  selected layers, and Quick Actions run by GIMPhoto's plug-ins.
+ */
+struct _GimpPropertiesEditor
+{
+  GimpImageEditor              parent_instance;
+
+  GimpPropertiesEditorPrivate *p;
+};
+
+struct _GimpPropertiesEditorClass
+{
+  GimpImageEditorClass  parent_class;
+};
+
+
+GType       gimp_properties_editor_get_type (void);
+
+GtkWidget * gimp_properties_editor_new      (GimpMenuFactory *menu_factory);
