+#pragma once
+
+#include "gimpselectiontool.h"
+
+
+#define GIMP_TYPE_OBJECT_SELECT_TOOL            (gimp_object_select_tool_get_type ())
+#define GIMP_OBJECT_SELECT_TOOL(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_OBJECT_SELECT_TOOL, GimpObjectSelectTool))
+#define GIMP_OBJECT_SELECT_TOOL_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass), GIMP_TYPE_OBJECT_SELECT_TOOL, GimpObjectSelectToolClass))
+#define GIMP_IS_OBJECT_SELECT_TOOL(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GIMP_TYPE_OBJECT_SELECT_TOOL))
+#define GIMP_IS_OBJECT_SELECT_TOOL_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass), GIMP_TYPE_OBJECT_SELECT_TOOL))
+#define GIMP_OBJECT_SELECT_TOOL_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj), GIMP_TYPE_OBJECT_SELECT_TOOL, GimpObjectSelectToolClass))
+
+
+typedef struct _GimpObjectSelectTool      GimpObjectSelectTool;
+typedef struct _GimpObjectSelectToolClass GimpObjectSelectToolClass;
+
+/*  GIMPhoto: Photoshop's Object Selection tool. Drag a rough box around an
+ *  object: GIMPhoto's AI plug-in (gimphoto-object-select, SAM 2.1 on the
+ *  local ComfyUI) makes the object the selection, with the tool's
+ *  selection mode (Shift adds, Ctrl subtracts, as the other selection
+ *  tools).
+ */
+struct _GimpObjectSelectTool
+{
+  GimpSelectionTool parent_instance;
+
+  gdouble           start_x;
+  gdouble           start_y;
+  gdouble           end_x;
+  gdouble           end_y;
+  GimpChannelOps    operation;
+  gboolean          running;  /*  the plug-in is finding an object  */
+
+  /*  the box to find the object in, waiting for the idle run  */
+  GimpImage        *image;
+  GimpDisplay      *display;
+  gint              x, y, width, height;
+};
+
+struct _GimpObjectSelectToolClass
+{
+  GimpSelectionToolClass parent_class;
+};
+
+
+void    gimp_object_select_tool_register (GimpToolRegisterCallback  callback,
+                                          gpointer                  data);
+
+GType   gimp_object_select_tool_get_type (void) G_GNUC_CONST;
