+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+#include "core/gimpparamspecs.h"
+#include "core/gimpprogress.h"
+
+#include "pdb/gimppdb.h"
+
+#include "widgets/gimphelp-ids.h"
+
+#include "display/gimpdisplay.h"
+
+#include "gimpobjectselecttool.h"
+#include "gimpselectionoptions.h"
+#include "gimptoolcontrol.h"
+
+#include "gimp-intl.h"
+
+
+/*  the plug-in procedure that finds the object (plugins/ai-select)  */
+#define OBJECT_SELECT_PROC "gimphoto-object-select"
+
+/*  smaller drags are clicks, not boxes  */
+#define MIN_BOX 4
+
+
+static void   gimp_object_select_tool_button_press   (GimpTool              *tool,
+                                                      const GimpCoords      *coords,
+                                                      guint32                time,
+                                                      GdkModifierType        state,
+                                                      GimpButtonPressType    press_type,
+                                                      GimpDisplay           *display);
+static void   gimp_object_select_tool_motion         (GimpTool              *tool,
+                                                      const GimpCoords      *coords,
+                                                      guint32                time,
+                                                      GdkModifierType        state,
+                                                      GimpDisplay           *display);
+static void   gimp_object_select_tool_button_release (GimpTool              *tool,
+                                                      const GimpCoords      *coords,
+                                                      guint32                time,
+                                                      GdkModifierType        state,
+                                                      GimpButtonReleaseType  release_type,
+                                                      GimpDisplay           *display);
+static void   gimp_object_select_tool_draw           (GimpDrawTool          *draw_tool);
+
+static gboolean gimp_object_select_tool_run_idle     (gpointer               data);
+
+
+G_DEFINE_TYPE (GimpObjectSelectTool, gimp_object_select_tool,
+               GIMP_TYPE_SELECTION_TOOL)
+
+#define parent_class gimp_object_select_tool_parent_class
+
+
+void
+gimp_object_select_tool_register (GimpToolRegisterCallback  callback,
+                                  gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_OBJECT_SELECT_TOOL,
+                GIMP_TYPE_SELECTION_OPTIONS,
+                gimp_selection_options_gui,
+                0,
+                "gimp-object-select-tool",
+                _("Object Selection"),
+                _("Object Selection Tool: Drag a box around an object to "
+                  "select it (AI)"),
+                N_("_Object Selection"), NULL,
+                NULL, GIMP_HELP_TOOL_FUZZY_SELECT,
+                "gimphoto-object-select",
+                data);
+}
+
+static void
+gimp_object_select_tool_class_init (GimpObjectSelectToolClass *klass)
+{
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  tool_class->button_press   = gimp_object_select_tool_button_press;
+  tool_class->motion         = gimp_object_select_tool_motion;
+  tool_class->button_release = gimp_object_select_tool_button_release;
+
+  draw_tool_class->draw      = gimp_object_select_tool_draw;
+}
+
+static void
+gimp_object_select_tool_init (GimpObjectSelectTool *object_select)
+{
+  GimpTool *tool = GIMP_TOOL (object_select);
+
+  gimp_tool_control_set_tool_cursor (tool->control,
+                                     GIMP_TOOL_CURSOR_RECT_SELECT);
+}
+
+static void
+gimp_object_select_tool_button_press (GimpTool            *tool,
+                                      const GimpCoords    *coords,
+                                      guint32              time,
+                                      GdkModifierType      state,
+                                      GimpButtonPressType  press_type,
+                                      GimpDisplay         *display)
+{
+  GimpObjectSelectTool *object_select = GIMP_OBJECT_SELECT_TOOL (tool);
+  GimpSelectionOptions *options       = GIMP_SELECTION_TOOL_GET_OPTIONS (tool);
+
+  /*  the plug-in runs in a nested main loop: one box at a time  */
+  if (object_select->running)
+    return;
+
+  /*  moving or editing the selection, as the other selection tools  */
+  if (gimp_selection_tool_start_edit (GIMP_SELECTION_TOOL (tool),
+                                      display, coords))
+    return;
+
+  if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  object_select->start_x   = object_select->end_x = RINT (coords->x);
+  object_select->start_y   = object_select->end_y = RINT (coords->y);
+  object_select->operation = options->operation;
+
+  tool->display = display;
+  gimp_tool_control_activate (tool->control);
+  gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+}
+
+static void
+gimp_object_select_tool_motion (GimpTool         *tool,
+                                const GimpCoords *coords,
+                                guint32           time,
+                                GdkModifierType   state,
+                                GimpDisplay      *display)
+{
+  GimpObjectSelectTool *object_select = GIMP_OBJECT_SELECT_TOOL (tool);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  object_select->end_x = RINT (coords->x);
+  object_select->end_y = RINT (coords->y);
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_object_select_tool_button_release (GimpTool              *tool,
+                                        const GimpCoords      *coords,
+                                        guint32                time,
+                                        GdkModifierType        state,
+                                        GimpButtonReleaseType  release_type,
+                                        GimpDisplay           *display)
+{
+  GimpObjectSelectTool *object_select = GIMP_OBJECT_SELECT_TOOL (tool);
+  GimpImage            *image         = gimp_display_get_image (display);
+  gint                  x, y, width, height;
+
+  gimp_tool_control_halt (tool->control);
+  gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL)
+    return;
+
+  x      = MIN (object_select->start_x, object_select->end_x);
+  y      = MIN (object_select->start_y, object_select->end_y);
+  width  = ABS (object_select->end_x - object_select->start_x);
+  height = ABS (object_select->end_y - object_select->start_y);
+
+  /*  only what is on the canvas  */
+  width  = MIN (x + width,  gimp_image_get_width  (image)) - MAX (x, 0);
+  height = MIN (y + height, gimp_image_get_height (image)) - MAX (y, 0);
+  x      = MAX (x, 0);
+  y      = MAX (y, 0);
+
+  if (width < MIN_BOX || height < MIN_BOX)
+    return;
+
+  /*  the plug-in runs in a nested main loop, where the image can be
+   *  closed and the tool changed: run it once this event is done, with
+   *  the tool, image and display kept alive until it returns
+   */
+  object_select->running = TRUE;
+  object_select->image   = g_object_ref (image);
+  object_select->display = g_object_ref (display);
+  object_select->x       = x;
+  object_select->y       = y;
+  object_select->width   = width;
+  object_select->height  = height;
+
+  g_idle_add_full (G_PRIORITY_DEFAULT_IDLE,
+                   gimp_object_select_tool_run_idle,
+                   g_object_ref (object_select), g_object_unref);
+}
+
+static gboolean
+gimp_object_select_tool_run_idle (gpointer data)
+{
+  GimpObjectSelectTool *object_select = GIMP_OBJECT_SELECT_TOOL (data);
+  GimpImage            *image         = object_select->image;
+  GimpDisplay          *display       = object_select->display;
+  GimpValueArray       *return_vals;
+  GError               *error = NULL;
+
+  return_vals =
+    gimp_pdb_execute_procedure_by_name (image->gimp->pdb,
+                                        gimp_get_user_context (image->gimp),
+                                        GIMP_PROGRESS (display),
+                                        &error,
+                                        OBJECT_SELECT_PROC,
+                                        /*  not INTERACTIVE: libgimp would load the
+                                         *  last run's box over this one
+                                         */
+                                        GIMP_TYPE_RUN_MODE, GIMP_RUN_NONINTERACTIVE,
+                                        GIMP_TYPE_IMAGE,    image,
+                                        G_TYPE_INT,         object_select->operation,
+                                        G_TYPE_INT,         object_select->x,
+                                        G_TYPE_INT,         object_select->y,
+                                        G_TYPE_INT,         object_select->width,
+                                        G_TYPE_INT,         object_select->height,
+                                        G_TYPE_NONE);
+
+  if (error)
+    {
+      /*  the plug-in's own message (no local AI, ComfyUI not answering...)  */
+      gimp_message_literal (image->gimp, G_OBJECT (display),
+                            GIMP_MESSAGE_WARNING, error->message);
+      g_clear_error (&error);
+    }
+
+  gimp_value_array_unref (return_vals);
+  gimp_image_flush (image);
+
+  object_select->running = FALSE;
+  g_clear_object (&object_select->display);
+  g_clear_object (&object_select->image);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gimp_object_select_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpObjectSelectTool *object_select = GIMP_OBJECT_SELECT_TOOL (draw_tool);
+
+  gimp_draw_tool_add_rectangle (draw_tool, FALSE,
+                                MIN (object_select->start_x, object_select->end_x),
+                                MIN (object_select->start_y, object_select->end_y),
+                                ABS (object_select->end_x - object_select->start_x),
+                                ABS (object_select->end_y - object_select->start_y));
+}
