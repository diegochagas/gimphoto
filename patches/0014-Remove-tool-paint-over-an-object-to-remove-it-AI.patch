+#pragma once
+
+#include "gimpdrawtool.h"
+
+
+#define GIMP_TYPE_REMOVE_TOOL            (gimp_remove_tool_get_type ())
+#define GIMP_REMOVE_TOOL(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_REMOVE_TOOL, GimpRemoveTool))
+#define GIMP_REMOVE_TOOL_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass), GIMP_TYPE_REMOVE_TOOL, GimpRemoveToolClass))
+#define GIMP_IS_REMOVE_TOOL(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GIMP_TYPE_REMOVE_TOOL))
+#define GIMP_IS_REMOVE_TOOL_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass), GIMP_TYPE_REMOVE_TOOL))
+#define GIMP_REMOVE_TOOL_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj), GIMP_TYPE_REMOVE_TOOL, GimpRemoveToolClass))
+
+#define GIMP_REMOVE_TOOL_GET_OPTIONS(t)  (GIMP_REMOVE_OPTIONS (gimp_tool_get_options (GIMP_TOOL (t))))
+
+
+typedef struct _GimpRemoveTool      GimpRemoveTool;
+typedef struct _GimpRemoveToolClass GimpRemoveToolClass;
+
+struct _GimpRemoveTool
+{
+  GimpDrawTool  parent_instance;
+
+  GimpVector2   last_pos;  /*  the brush outline, under the pointer      */
+  GPtrArray    *strokes;   /*  RemoveStroke: painted, not removed yet    */
+  gpointer      stroke;    /*  RemoveStroke being painted, or NULL       */
+  gboolean      running;   /*  the plug-in is removing (one at a time)   */
+
+  /*  the removal waiting for its idle run  */
+  GimpImage    *image;
+  GimpDisplay  *display;
+  GimpDrawable *drawable;
+  gchar        *json;
+  gboolean      generative;
+};
+
+struct _GimpRemoveToolClass
+{
+  GimpDrawToolClass  parent_class;
+};
+
+
+void    gimp_remove_tool_register (GimpToolRegisterCallback  callback,
+                                   gpointer                  data);
+
+GType   gimp_remove_tool_get_type (void) G_GNUC_CONST;
