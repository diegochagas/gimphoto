+ */
+
+/*  GIMPhoto: Photoshop's Remove tool. Paint over an object (the strokes
+ *  shown pink); on release (or Enter, without "Remove after each stroke")
+ *  the plug-in procedure gimphoto-remove removes it with the local AI
+ *  (LaMa; FLUX.2 klein with Generative fill).
+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+#include <gdk/gdkkeysyms.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpdrawable.h"
+#include "core/gimpimage.h"
+#include "core/gimpparamspecs.h"
+#include "core/gimpprogress.h"
+
+#include "pdb/gimppdb.h"
+
+#include "widgets/gimphelp-ids.h"
+
+#include "display/gimpcanvaspen.h"
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+
+#include "gimpremoveoptions.h"
+#include "gimpremovetool.h"
+#include "gimptoolcontrol.h"
+
+#include "gimp-intl.h"
+
+
+/*  the plug-in procedure that removes (plugins/generative-fill)  */
+#define REMOVE_PROC "gimphoto-remove"
+
+
+typedef struct
+{
+  gint    size;
+  GArray *points;  /*  GimpVector2, image coordinates  */
+} RemoveStroke;
+
+
+static void       gimp_remove_tool_finalize       (GObject               *object);
+
+static void       gimp_remove_tool_control        (GimpTool              *tool,
+                                                   GimpToolAction         action,
+                                                   GimpDisplay           *display);
+static void       gimp_remove_tool_button_press   (GimpTool              *tool,
+                                                   const GimpCoords      *coords,
+                                                   guint32                time,
+                                                   GdkModifierType        state,
+                                                   GimpButtonPressType    press_type,
+                                                   GimpDisplay           *display);
+static void       gimp_remove_tool_button_release (GimpTool              *tool,
+                                                   const GimpCoords      *coords,
+                                                   guint32                time,
+                                                   GdkModifierType        state,
+                                                   GimpButtonReleaseType  release_type,
+                                                   GimpDisplay           *display);
+static void       gimp_remove_tool_motion         (GimpTool              *tool,
+                                                   const GimpCoords      *coords,
+                                                   guint32                time,
+                                                   GdkModifierType        state,
+                                                   GimpDisplay           *display);
+static gboolean   gimp_remove_tool_key_press      (GimpTool              *tool,
+                                                   GdkEventKey           *kevent,
+                                                   GimpDisplay           *display);
+static void       gimp_remove_tool_oper_update    (GimpTool              *tool,
+                                                   const GimpCoords      *coords,
+                                                   GdkModifierType        state,
+                                                   gboolean               proximity,
+                                                   GimpDisplay           *display);
+
+static void       gimp_remove_tool_draw           (GimpDrawTool          *draw_tool);
+
+static void       gimp_remove_tool_clear          (GimpRemoveTool        *remove);
+static void       gimp_remove_tool_start          (GimpRemoveTool        *remove,
+                                                   GimpDisplay           *display);
+static gboolean   gimp_remove_tool_run_idle       (gpointer               data);
+
+
+G_DEFINE_TYPE (GimpRemoveTool, gimp_remove_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define parent_class gimp_remove_tool_parent_class
+
+
+void
+gimp_remove_tool_register (GimpToolRegisterCallback  callback,
+                           gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_REMOVE_TOOL,
+                GIMP_TYPE_REMOVE_OPTIONS,
+                gimp_remove_options_gui,
+                0,
+                "gimp-remove-tool",
+                _("Remove"),
+                _("Remove Tool: Paint over an object to remove it (AI)"),
+                N_("_Remove"), NULL,
+                NULL, GIMP_HELP_TOOL_HEAL,
+                "gimphoto-remove",
+                data);
+}
+
+static void
+gimp_remove_tool_class_init (GimpRemoveToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_remove_tool_finalize;
+
+  tool_class->control        = gimp_remove_tool_control;
+  tool_class->button_press   = gimp_remove_tool_button_press;
+  tool_class->button_release = gimp_remove_tool_button_release;
+  tool_class->motion         = gimp_remove_tool_motion;
+  tool_class->key_press      = gimp_remove_tool_key_press;
+  tool_class->oper_update    = gimp_remove_tool_oper_update;
+
+  draw_tool_class->draw      = gimp_remove_tool_draw;
+}
+
+static void
+remove_stroke_free (gpointer data)
+{
+  RemoveStroke *stroke = data;
+
+  g_array_free (stroke->points, TRUE);
+  g_free (stroke);
+}
+
+static void
+gimp_remove_tool_init (GimpRemoveTool *remove)
+{
+  GimpTool *tool = GIMP_TOOL (remove);
+
+  gimp_tool_control_set_motion_mode   (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_scroll_lock   (tool->control, FALSE);
+  gimp_tool_control_set_precision     (tool->control,
+                                       GIMP_CURSOR_PRECISION_SUBPIXEL);
+  gimp_tool_control_set_tool_cursor   (tool->control,
+                                       GIMP_TOOL_CURSOR_PAINTBRUSH);
+  gimp_tool_control_set_action_size   (tool->control,
+                                       "tools-remove-size-set");
+
+  remove->strokes = g_ptr_array_new_with_free_func (remove_stroke_free);
+}
+
+static void
+gimp_remove_tool_finalize (GObject *object)
+{
+  GimpRemoveTool *remove = GIMP_REMOVE_TOOL (object);
+
+  g_clear_pointer (&remove->strokes, g_ptr_array_unref);
+  g_clear_pointer (&remove->stroke, remove_stroke_free);
+  g_clear_pointer (&remove->json, g_free);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+static void
+gimp_remove_tool_control (GimpTool       *tool,
+                          GimpToolAction  action,
+                          GimpDisplay    *display)
+{
+  if (action == GIMP_TOOL_ACTION_HALT)
+    gimp_remove_tool_clear (GIMP_REMOVE_TOOL (tool));
+
+  GIMP_TOOL_CLASS (parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_remove_tool_add_point (GimpRemoveTool   *remove,
+                            const GimpCoords *coords)
+{
+  GimpVector2 point = { coords->x, coords->y };
+
+  g_array_append_val (((RemoveStroke *) remove->stroke)->points, point);
+}
+
+static void
+gimp_remove_tool_button_press (GimpTool            *tool,
+                               const GimpCoords    *coords,
+                               guint32              time,
+                               GdkModifierType      state,
+                               GimpButtonPressType  press_type,
+                               GimpDisplay         *display)
+{
+  GimpRemoveTool    *remove  = GIMP_REMOVE_TOOL (tool);
+  GimpRemoveOptions *options = GIMP_REMOVE_TOOL_GET_OPTIONS (tool);
+  GimpImage         *image   = gimp_display_get_image (display);
+  GList             *drawables;
+  RemoveStroke      *stroke;
+
+  /*  the plug-in runs in a nested main loop: one removal at a time  */
+  if (remove->running || press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return;
+
+  drawables = gimp_image_get_selected_drawables (image);
+
+  if (! drawables)
+    {
+      gimp_tool_message_literal (tool, display,
+                                 _("Select the layer to remove from."));
+      return;
+    }
+
+  g_list_free (drawables);
+
+  if (tool->display && tool->display != display)
+    gimp_tool_control (tool, GIMP_TOOL_ACTION_HALT, tool->display);
+
+  stroke         = g_new0 (RemoveStroke, 1);
+  stroke->size   = options->size;
+  stroke->points = g_array_new (FALSE, FALSE, sizeof (GimpVector2));
+  remove->stroke = stroke;
+  gimp_remove_tool_add_point (remove, coords);
+
+  tool->display = display;
+  gimp_tool_control_activate (tool->control);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+  if (! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_remove_tool_motion (GimpTool         *tool,
+                         const GimpCoords *coords,
+                         guint32           time,
+                         GdkModifierType   state,
+                         GimpDisplay      *display)
+{
+  GimpRemoveTool *remove = GIMP_REMOVE_TOOL (tool);
+  GArray         *points;
+  GimpVector2    *last;
+
+  if (! remove->stroke)
+    return;
+
+  points = ((RemoveStroke *) remove->stroke)->points;
+  last   = &g_array_index (points, GimpVector2, points->len - 1);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  remove->last_pos.x = coords->x;
+  remove->last_pos.y = coords->y;
+
+  if (fabs (coords->x - last->x) >= 1.0 || fabs (coords->y - last->y) >= 1.0)
+    gimp_remove_tool_add_point (remove, coords);
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_remove_tool_button_release (GimpTool              *tool,
+                                 const GimpCoords      *coords,
+                                 guint32                time,
+                                 GdkModifierType        state,
+                                 GimpButtonReleaseType  release_type,
+                                 GimpDisplay           *display)
+{
+  GimpRemoveTool    *remove  = GIMP_REMOVE_TOOL (tool);
+  GimpRemoveOptions *options = GIMP_REMOVE_TOOL_GET_OPTIONS (tool);
+
+  gimp_tool_control_halt (tool->control);
+
+  if (! remove->stroke)
+    return;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL)
+    g_clear_pointer (&remove->stroke, remove_stroke_free);
+  else
+    g_ptr_array_add (remove->strokes, g_steal_pointer (&remove->stroke));
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+
+  if (options->remove_after_stroke && remove->strokes->len > 0)
+    gimp_remove_tool_start (remove, display);
+}
+
+static gboolean
+gimp_remove_tool_key_press (GimpTool    *tool,
+                            GdkEventKey *kevent,
+                            GimpDisplay *display)
+{
+  GimpRemoveTool *remove = GIMP_REMOVE_TOOL (tool);
+
+  if (display != tool->display || remove->running)
+    return FALSE;
+
+  switch (kevent->keyval)
+    {
+    case GDK_KEY_Return:
+    case GDK_KEY_KP_Enter:
+    case GDK_KEY_ISO_Enter:
+      if (remove->strokes->len > 0)
+        {
+          gimp_remove_tool_start (remove, display);
+          return TRUE;
+        }
+      break;
+
+    case GDK_KEY_Escape:
+      if (remove->strokes->len > 0)
+        {
+          gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+          g_ptr_array_set_size (remove->strokes, 0);
+          gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+          return TRUE;
+        }
+      break;
+
+    default:
+      break;
+    }
+
+  return FALSE;
+}
+
+static void
+gimp_remove_tool_oper_update (GimpTool         *tool,
+                              const GimpCoords *coords,
+                              GdkModifierType   state,
+                              gboolean          proximity,
+                              GimpDisplay      *display)
+{
+  GimpRemoveTool *remove    = GIMP_REMOVE_TOOL (tool);
+  GimpDrawTool   *draw_tool = GIMP_DRAW_TOOL (tool);
+
+  if (proximity)
+    {
+      gimp_draw_tool_pause (draw_tool);
+
+      if (! tool->display || display == tool->display)
+        {
+          remove->last_pos.x = coords->x;
+          remove->last_pos.y = coords->y;
+        }
+
+      if (! gimp_draw_tool_is_active (draw_tool))
+        gimp_draw_tool_start (draw_tool, display);
+
+      gimp_draw_tool_resume (draw_tool);
+    }
+  else if (gimp_draw_tool_is_active (draw_tool) &&
+           remove->strokes->len == 0 && ! remove->stroke)
+    {
+      gimp_draw_tool_stop (draw_tool);
+    }
+}
+
+static void
+gimp_remove_tool_draw_stroke (GimpDrawTool *draw_tool,
+                              RemoveStroke *stroke,
+                              GeglColor    *color)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (draw_tool->display);
+  GArray           *points = stroke->points;
+  GimpVector2       dab[2];
+  GimpArray        *array;
+  GimpCanvasItem   *item;
+
+  if (points->len == 1)
+    {
+      /*  a click: a dab, as a stroke of two equal points  */
+      dab[0] = dab[1] = g_array_index (points, GimpVector2, 0);
+      array  = gimp_array_new ((const guint8 *) dab, sizeof (dab), TRUE);
+    }
+  else
+    {
+      array = gimp_array_new ((const guint8 *) points->data,
+                              points->len * sizeof (GimpVector2), TRUE);
+    }
+
+  item = g_object_new (GIMP_TYPE_CANVAS_PEN,
+                       "shell",  shell,
+                       "points", array,
+                       "color",  color,
+                       "width",  MAX (1, (gint) (stroke->size * shell->scale_y)),
+                       NULL);
+  gimp_draw_tool_add_item (draw_tool, item);
+
+  g_object_unref (item);
+  gimp_array_free (array);
+}
+
+static void
+gimp_remove_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpRemoveTool    *remove  = GIMP_REMOVE_TOOL (draw_tool);
+  GimpRemoveOptions *options = GIMP_REMOVE_TOOL_GET_OPTIONS (draw_tool);
+  GeglColor         *pink    = gegl_color_new (NULL);
+  guint              i;
+
+  /*  Photoshop's pink, see-through  */
+  gegl_color_set_rgba (pink, 1.0, 0.25, 0.6, 0.5);
+
+  for (i = 0; i < remove->strokes->len; i++)
+    gimp_remove_tool_draw_stroke (draw_tool,
+                                  g_ptr_array_index (remove->strokes, i),
+                                  pink);
+
+  if (remove->stroke)
+    gimp_remove_tool_draw_stroke (draw_tool, remove->stroke, pink);
+
+  g_object_unref (pink);
+
+  /*  the brush outline under the pointer  */
+  gimp_draw_tool_add_arc (draw_tool, FALSE,
+                          remove->last_pos.x - options->size / 2.0,
+                          remove->last_pos.y - options->size / 2.0,
+                          options->size, options->size,
+                          0.0, 2.0 * G_PI);
+}
+
+static void
+gimp_remove_tool_clear (GimpRemoveTool *remove)
+{
+  GimpDrawTool *draw_tool = GIMP_DRAW_TOOL (remove);
+
+  if (gimp_draw_tool_is_active (draw_tool))
+    gimp_draw_tool_stop (draw_tool);
+
+  g_clear_pointer (&remove->stroke, remove_stroke_free);
+  g_ptr_array_set_size (remove->strokes, 0);
+
+  GIMP_TOOL (remove)->display = NULL;
+}
+
+/*  JSON for the plug-in: [{"size": n, "points": [x0, y0, x1, y1, ...]}]  */
+static gchar *
+gimp_remove_tool_strokes_json (GimpRemoveTool *remove)
+{
+  GString *json = g_string_new ("[");
+  gchar    buf[G_ASCII_DTOSTR_BUF_SIZE];
+  guint    i, j;
+
+  for (i = 0; i < remove->strokes->len; i++)
+    {
+      RemoveStroke *stroke = g_ptr_array_index (remove->strokes, i);
+
+      g_string_append_printf (json, "%s{\"size\": %d, \"points\": [",
+                              i ? ", " : "", stroke->size);
+
+      for (j = 0; j < stroke->points->len; j++)
+        {
+          GimpVector2 *point = &g_array_index (stroke->points, GimpVector2, j);
+
+          g_string_append (json, j ? ", " : "");
+          g_string_append (json, g_ascii_dtostr (buf, sizeof (buf), point->x));
+          g_string_append (json, ", ");
+          g_string_append (json, g_ascii_dtostr (buf, sizeof (buf), point->y));
+        }
+
+      g_string_append (json, "]}");
+    }
+
+  g_string_append (json, "]");
+
+  return g_string_free (json, FALSE);
+}
+
+static void
+gimp_remove_tool_start (GimpRemoveTool *remove,
+                        GimpDisplay    *display)
+{
+  GimpRemoveOptions *options = GIMP_REMOVE_TOOL_GET_OPTIONS (remove);
+  GimpImage         *image   = gimp_display_get_image (display);
+  GList             *drawables;
+
+  drawables = gimp_image_get_selected_drawables (image);
+
+  if (! drawables)
+    {
+      gimp_tool_message_literal (GIMP_TOOL (remove), display,
+                                 _("Select the layer to remove from."));
+      return;
+    }
+
+  /*  the plug-in runs in a nested main loop, where the image can be
+   *  closed and the tool changed: run it once this event is done, with
+   *  the tool, image, display and drawable kept alive until it returns
+   */
+  remove->running      = TRUE;
+  remove->image        = g_object_ref (image);
+  remove->display      = g_object_ref (display);
+  remove->drawable     = g_object_ref (drawables->data);
+  remove->json         = gimp_remove_tool_strokes_json (remove);
+  remove->generative   = options->generative;
+
+  g_list_free (drawables);
+
+  g_idle_add_full (G_PRIORITY_DEFAULT_IDLE,
+                   gimp_remove_tool_run_idle,
+                   g_object_ref (remove), g_object_unref);
+}
+
+static gboolean
+gimp_remove_tool_run_idle (gpointer data)
+{
+  GimpRemoveTool *remove = GIMP_REMOVE_TOOL (data);
+  GimpImage      *image  = remove->image;
+  GimpValueArray *return_vals;
+  GError         *error  = NULL;
+
+  return_vals =
+    gimp_pdb_execute_procedure_by_name (image->gimp->pdb,
+                                        gimp_get_user_context (image->gimp),
+                                        GIMP_PROGRESS (remove->display),
+                                        &error,
+                                        REMOVE_PROC,
+                                        GIMP_TYPE_RUN_MODE, GIMP_RUN_NONINTERACTIVE,
+                                        GIMP_TYPE_IMAGE,    image,
+                                        GIMP_TYPE_DRAWABLE, remove->drawable,
+                                        G_TYPE_STRING,      remove->json,
+                                        G_TYPE_STRING,      remove->generative ?
+                                                            "klein" : "lama",
+                                        G_TYPE_NONE);
+
+  if (error)
+    {
+      /*  the plug-in's own message (no local AI, ComfyUI not answering...)  */
+      gimp_message_literal (image->gimp, G_OBJECT (remove->display),
+                            GIMP_MESSAGE_WARNING, error->message);
+      g_clear_error (&error);
+    }
+
+  gimp_value_array_unref (return_vals);
+  gimp_image_flush (image);
+
+  /*  the strokes are done (removed, or failed and reported)  */
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (remove));
+  g_ptr_array_set_size (remove->strokes, 0);
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (remove));
+
+  remove->running = FALSE;
+  g_clear_pointer (&remove->json, g_free);
+  g_clear_object (&remove->drawable);
+  g_clear_object (&remove->display);
+  g_clear_object (&remove->image);
+
+  return G_SOURCE_REMOVE;
+}
