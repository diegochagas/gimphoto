+  PROP_REMOVE_AFTER_STROKE
+};
+
+
+static void   gimp_remove_options_set_property (GObject      *object,
+                                                guint         property_id,
+                                                const GValue *value,
+                                                GParamSpec   *pspec);
+static void   gimp_remove_options_get_property (GObject      *object,
+                                                guint         property_id,
+                                                GValue       *value,
+                                                GParamSpec   *pspec);
+
+
+G_DEFINE_TYPE (GimpRemoveOptions, gimp_remove_options,
+               GIMP_TYPE_TOOL_OPTIONS)
+
+
+static void
+gimp_remove_options_class_init (GimpRemoveOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_remove_options_set_property;
+  object_class->get_property = gimp_remove_options_get_property;
+
+  GIMP_CONFIG_PROP_INT (object_class, PROP_SIZE,
+                        "size",
+                        _("Size"),
+                        _("Size of the brush that marks what to remove"),
+                        1, 1000, 50,
+                        GIMP_PARAM_STATIC_STRINGS);
+
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_GENERATIVE,
+                            "generative",
+                            _("Generative fill (slower)"),
+                            _("Fill with FLUX.2 klein (about 30 seconds), which "
+                              "redraws the area, instead of LaMa (about a "
+                              "second), which continues what is around it"),
+                            FALSE,
+                            GIMP_PARAM_STATIC_STRINGS);
+
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_REMOVE_AFTER_STROKE,
+                            "remove-after-stroke",
+                            _("Remove after each stroke"),
+                            _("Remove when the button is released; otherwise "
+                              "strokes add up until Enter (Escape clears them)"),
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+}
+
+static void
+gimp_remove_options_init (GimpRemoveOptions *options)
+{
+}
+
+static void
+gimp_remove_options_set_property (GObject      *object,
+                                  guint         property_id,
+                                  const GValue *value,
+                                  GParamSpec   *pspec)
+{
+  GimpRemoveOptions *options = GIMP_REMOVE_OPTIONS (object);
+
+  switch (property_id)
+    {
+    case PROP_SIZE:
+      options->size = g_value_get_int (value);
+      break;
+    case PROP_GENERATIVE:
+      options->generative = g_value_get_boolean (value);
+      break;
+    case PROP_REMOVE_AFTER_STROKE:
+      options->remove_after_stroke = g_value_get_boolean (value);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_remove_options_get_property (GObject    *object,
+                                  guint       property_id,
+                                  GValue     *value,
+                                  GParamSpec *pspec)
+{
+  GimpRemoveOptions *options = GIMP_REMOVE_OPTIONS (object);
+
+  switch (property_id)
+    {
+    case PROP_SIZE:
+      g_value_set_int (value, options->size);
+      break;
+    case PROP_GENERATIVE:
+      g_value_set_boolean (value, options->generative);
+      break;
+    case PROP_REMOVE_AFTER_STROKE:
+      g_value_set_boolean (value, options->remove_after_stroke);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+GtkWidget *
+gimp_remove_options_gui (GimpToolOptions *tool_options)
+{
+  GObject   *config = G_OBJECT (tool_options);
+  GtkWidget *vbox   = gimp_tool_options_gui (tool_options);
+  GtkWidget *scale;
+  GtkWidget *button;
+
+  scale = gimp_prop_spin_scale_new (config, "size", 1.0, 10.0, 0);
+  gimp_spin_scale_set_scale_limits (GIMP_SPIN_SCALE (scale), 1.0, 500.0);
+  gimp_spin_scale_set_gamma (GIMP_SPIN_SCALE (scale), 1.7);
+  gtk_box_pack_start (GTK_BOX (vbox), scale, FALSE, FALSE, 0);
+
+  button = gimp_prop_check_button_new (config, "remove-after-stroke", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), button, FALSE, FALSE, 0);
+
+  button = gimp_prop_check_button_new (config, "generative", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), button, FALSE, FALSE, 0);
+
+  return vbox;
+}
