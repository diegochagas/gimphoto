  *  Image (it carries their "gimphoto-generative" parasite) opens their
  *  window again, through the generative-fill plug-in's Edit Generative
@@ -304,6 +372,8 @@ layers_edit_cmd_callback (GimpAction *action,
     return;
   else if (layers_edit_generative (layers->data))
     return;
+  else if (layers_edit_adjustment (layers->data))
+    return;
   else if (gimp_item_is_vector_layer (GIMP_ITEM (layers->data)))
     layers_edit_vector_cmd_callback (action, value, data);
