+#define GIMP_IS_ADJUSTMENT_LAYER_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass), GIMP_TYPE_ADJUSTMENT_LAYER))
+#define GIMP_ADJUSTMENT_LAYER_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj), GIMP_TYPE_ADJUSTMENT_LAYER, GimpAdjustmentLayerClass))
+
+
+typedef struct _GimpAdjustmentLayerClass GimpAdjustmentLayerClass;
+
+/* A Photoshop-style adjustment layer: a layer with no pixels of its own
+ * whose filters (GIMP's non-destructive filters, e.g. Curves or Levels)
+ * apply to everything composited below it in its group. It is kept the
+ * size of the canvas, and its mask, opacity and mode limit the adjustment
+ * like Photoshop's.
+ */
+struct _GimpAdjustmentLayer
+{
+  GimpLayer  parent_instance;
+};
+
+struct _GimpAdjustmentLayerClass
+{
+  GimpLayerClass  parent_class;
+};
+
+
+GType       gimp_adjustment_layer_get_type (void) G_GNUC_CONST;
+
+GimpLayer * gimp_adjustment_layer_new      (GimpImage   *image,
+                                            const gchar *name);
