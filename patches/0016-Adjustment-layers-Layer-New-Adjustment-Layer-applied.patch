+/*  GIMPhoto: a double click on an adjustment layer opens its adjustment
+ *  again (the filter it carries), as Photoshop's Properties panel does.
+ *  Returns FALSE when it has none, so the caller opens the attributes as
+ *  GIMP does.
+ */
+static gboolean
+layers_edit_adjustment (GimpLayer *layer)
+{
+  GimpContainer      *filters;
+  GimpDrawableFilter *filter = NULL;
+  GimpProcedure      *procedure;
+  GeglNode           *op;
+  Gimp               *gimp;
+  GList              *list;
+  gchar              *operation = NULL;
+
+  if (! GIMP_IS_ADJUSTMENT_LAYER (layer))
+    return FALSE;
+
+  filters = gimp_drawable_get_filters (GIMP_DRAWABLE (layer));
+
+  for (list = GIMP_LIST (filters)->queue->head; list; list = g_list_next (list))
+    {
+      if (GIMP_IS_DRAWABLE_FILTER (list->data) &&
+          ! gimp_drawable_filter_get_temporary (list->data))
+        {
+          filter = list->data;
+          break;
+        }
+    }
+
+  if (! filter)
+    return FALSE;
+
+  op = gimp_drawable_filter_get_operation (filter);
+
+  if (op)
+    g_object_get (op, "operation", &operation, NULL);
+
+  if (! operation)
+    return FALSE;
+
+  gimp = gimp_item_get_image (GIMP_ITEM (layer))->gimp;
+
+  procedure = gimp_gegl_procedure_new (gimp, filter,
+                                       GIMP_RUN_INTERACTIVE, NULL,
+                                       operation,
+                                       gimp_object_get_name (filter),
+                                       gimp_object_get_name (filter),
+                                       NULL, NULL, NULL);
+
+  filters_run_procedure (gimp,
+                         gimp_context_get_display (gimp_get_user_context (gimp)),
+                         procedure, GIMP_RUN_INTERACTIVE);
+
+  g_object_unref (procedure);
+  g_free (operation);
+
+  return TRUE;
+}
+
