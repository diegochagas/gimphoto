+ * one, so the layer's filter stack is applied to the backdrop, and the
+ * result is blended over the backdrop by the layer's mode node with the
+ * layer's mode, opacity and mask, as Photoshop composites an adjustment
+ * layer. The layer's own buffer stays transparent and is never shown.
+ */
+
+static GeglNode      * gimp_adjustment_layer_get_source_node   (GimpDrawable  *drawable);
+static GeglRectangle   gimp_adjustment_layer_get_bounding_box  (GimpLayer     *layer);
+static gboolean        gimp_adjustment_layer_is_position_locked
+                                                               (GimpItem      *item,
+                                                                GimpItem     **locked_item,
+                                                                gboolean       checking_children);
+
+
+G_DEFINE_TYPE (GimpAdjustmentLayer, gimp_adjustment_layer, GIMP_TYPE_LAYER)
+
+#define parent_class gimp_adjustment_layer_parent_class
+
+
+static void
+gimp_adjustment_layer_class_init (GimpAdjustmentLayerClass *klass)
+{
+  GimpViewableClass *viewable_class = GIMP_VIEWABLE_CLASS (klass);
+  GimpItemClass     *item_class     = GIMP_ITEM_CLASS (klass);
+  GimpDrawableClass *drawable_class = GIMP_DRAWABLE_CLASS (klass);
+  GimpLayerClass    *layer_class    = GIMP_LAYER_CLASS (klass);
+
+  viewable_class->default_icon_name = "gimphoto-adjustment-layer";
+  viewable_class->default_name      = _("Adjustment Layer");
+
+  item_class->is_position_locked    = gimp_adjustment_layer_is_position_locked;
+  item_class->rename_desc           = _("Rename Adjustment Layer");
+  item_class->resize_desc           = _("Resize Adjustment Layer");
+
+  drawable_class->get_source_node   = gimp_adjustment_layer_get_source_node;
+
+  layer_class->get_bounding_box     = gimp_adjustment_layer_get_bounding_box;
+}
+
+static void
+gimp_adjustment_layer_init (GimpAdjustmentLayer *layer)
+{
+}
+
+static GeglNode *
+gimp_adjustment_layer_get_source_node (GimpDrawable *drawable)
+{
+  /* a pass-through: its "input" pad receives the backdrop, see above */
+  return gegl_node_new_child (NULL,
+                              "operation", "gegl:nop",
+                              NULL);
+}
+
+static GeglRectangle
+gimp_adjustment_layer_get_bounding_box (GimpLayer *layer)
+{
+  GeglRectangle bounding_box;
+
+  /* GimpDrawable asks the source node, which here depends on what is
+   * connected below the layer; the adjustment covers the layer's own
+   * area, kept the size of the canvas.
+   */
+  bounding_box.x      = 0;
+  bounding_box.y      = 0;
+  bounding_box.width  = gimp_item_get_width  (GIMP_ITEM (layer));
+  bounding_box.height = gimp_item_get_height (GIMP_ITEM (layer));
+
+  return bounding_box;
+}
+
+static gboolean
+gimp_adjustment_layer_is_position_locked (GimpItem  *item,
+                                          GimpItem **locked_item,
+                                          gboolean   checking_children)
+{
+  /* always the size and position of the canvas, as in Photoshop */
+  if (locked_item)
+    *locked_item = item;
+
+  return TRUE;
+}
+
+
+/*  public functions  */
+
+GimpLayer *
+gimp_adjustment_layer_new (GimpImage   *image,
+                           const gchar *name)
+{
+  GimpLayer *layer;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  layer = GIMP_LAYER (gimp_drawable_new (GIMP_TYPE_ADJUSTMENT_LAYER,
+                                         image, name,
+                                         0, 0,
+                                         gimp_image_get_width  (image),
+                                         gimp_image_get_height (image),
+                                         gimp_image_get_layer_format (image,
+                                                                      TRUE)));
+
+  gimp_layer_set_mode (layer,
+                       gimp_image_get_default_new_layer_mode (image),
+                       FALSE);
+
+  return layer;
+}
