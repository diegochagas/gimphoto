+/*  GIMPhoto: Photoshop's Layer > New Adjustment Layer. The new layer is
+ *  added above the selected layer with a mask from the selection, and the
+ *  adjustment's dialog opens on it. When the dialog is cancelled the layer
+ *  goes away again; when it is confirmed, the mask becomes what is edited,
+ *  so painting restricts the adjustment, as in Photoshop.
+ */
+
+typedef struct
+{
+  Gimp      *gimp;
+  GimpLayer *layer;
+  guint      idle_id;
+} NewAdjustmentWatch;
+
+static void     layers_new_adjustment_filters_changed (GimpDrawable       *drawable,
+                                                       NewAdjustmentWatch *watch);
+static void     layers_new_adjustment_removed         (GimpItem           *item,
+                                                       NewAdjustmentWatch *watch);
+
+static void
+layers_new_adjustment_watch_free (NewAdjustmentWatch *watch)
+{
+  g_signal_handlers_disconnect_by_func (watch->layer,
+                                        layers_new_adjustment_filters_changed,
+                                        watch);
+  g_signal_handlers_disconnect_by_func (watch->layer,
+                                        layers_new_adjustment_removed,
+                                        watch);
+
+  if (watch->idle_id)
+    g_source_remove (watch->idle_id);
+
+  g_object_unref (watch->layer);
+  g_slice_free (NewAdjustmentWatch, watch);
+}
+
+static gboolean
+layers_new_adjustment_settled (gpointer user_data)
+{
+  NewAdjustmentWatch *watch = user_data;
+  GimpLayer          *layer = watch->layer;
+  GimpTool           *tool  = tool_manager_get_active (watch->gimp);
+
+  watch->idle_id = 0;
+
+  /*  the adjustment's dialog is still open on this layer: wait  */
+  if (GIMP_IS_FILTER_TOOL (tool) && GIMP_FILTER_TOOL (tool)->filter &&
+      g_list_find (tool->drawables, layer))
+    return G_SOURCE_REMOVE;
+
+  g_signal_handlers_disconnect_by_func (layer,
+                                        layers_new_adjustment_filters_changed,
+                                        watch);
+  g_signal_handlers_disconnect_by_func (layer,
+                                        layers_new_adjustment_removed,
+                                        watch);
+
+  if (gimp_item_is_attached (GIMP_ITEM (layer)))
+    {
+      GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+
+      if (gimp_container_is_empty (gimp_drawable_get_filters (GIMP_DRAWABLE (layer))))
+        {
+          /*  cancelled: no adjustment, no layer  */
+          gimp_image_remove_layer (image, layer, TRUE, NULL);
+        }
+      else if (gimp_layer_get_mask (layer))
+        {
+          gimp_layer_set_edit_mask (layer, TRUE);
+        }
+
+      gimp_image_flush (image);
+    }
+
+  layers_new_adjustment_watch_free (watch);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+layers_new_adjustment_filters_changed (GimpDrawable       *drawable,
+                                       NewAdjustmentWatch *watch)
+{
+  /*  after the tool has finished with the layer  */
+  if (! watch->idle_id)
+    watch->idle_id = g_idle_add (layers_new_adjustment_settled, watch);
+}
+
+static void
+layers_new_adjustment_removed (GimpItem           *item,
+                               NewAdjustmentWatch *watch)
+{
+  /*  gone from the image (deleted, or the image closed): nothing to settle  */
+  layers_new_adjustment_watch_free (watch);
+}
+
+/*  the filter's menu label, as the layer's name: "_Curves..." -> "Curves"  */
+static gchar *
+layers_new_adjustment_name (GimpAction *filter_action)
+{
+  const gchar *label = gimp_action_get_label (filter_action);
+  GString     *name  = g_string_new (NULL);
+
+  for (; label && *label; label++)
+    if (*label != '_')
+      g_string_append_c (name, *label);
+
+  if (g_str_has_suffix (name->str, "..."))
+    g_string_truncate (name, name->len - 3);
+  else if (g_str_has_suffix (name->str, "\342\200\246"))
+    g_string_truncate (name, name->len - 3);
+
+  return g_string_free (name, FALSE);
+}
+
+void
+layers_new_adjustment_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage          *image;
+  GimpLayer          *layer;
+  GimpLayer          *parent   = NULL;
+  gint                position = 0;
+  GList              *layers;
+  GList              *list;
+  GList              *managers;
+  GimpAction         *filter_action = NULL;
+  GVariant           *filter_value;
+  GimpChannel        *selection;
+  GimpLayerMask      *mask;
+  NewAdjustmentWatch *watch;
+  gchar              *name;
+  return_if_no_image (image, data);
+
+  managers = gimp_ui_managers_from_name ("<Image>");
+
+  if (managers)
+    filter_action = gimp_ui_manager_find_action (managers->data, "filters",
+                                                 g_variant_get_string (value,
+                                                                       NULL));
+
+  if (! GIMP_IS_STRING_ACTION (filter_action))
+    return;
+
+  /*  above the selected layer, or at the top of a selected group  */
+  layers = gimp_image_get_selected_layers (image);
+
+  if (layers)
+    {
+      if (gimp_viewable_get_children (GIMP_VIEWABLE (layers->data)))
+        {
+          parent   = layers->data;
+          position = 0;
+        }
+      else
+        {
+          parent   = GIMP_LAYER (gimp_item_get_parent (layers->data));
+          position = gimp_item_get_index (layers->data);
+        }
+    }
+
+  name  = layers_new_adjustment_name (filter_action);
+  layer = gimp_adjustment_layer_new (image, name);
+  g_free (name);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               _("New Adjustment Layer"));
+
+  gimp_image_add_layer (image, layer, parent, position, TRUE);
+
+  /*  its mask comes from the selection, which is then dropped  */
+  selection = gimp_image_get_mask (image);
+
+  if (gimp_channel_is_empty (selection))
+    {
+      mask = gimp_layer_create_mask (layer, GIMP_ADD_MASK_WHITE, NULL);
+    }
+  else
+    {
+      mask = gimp_layer_create_mask (layer, GIMP_ADD_MASK_SELECTION, NULL);
+      gimp_channel_clear (selection, NULL, TRUE);
+    }
+
+  gimp_layer_add_mask (layer, mask, FALSE, TRUE, NULL);
+
+  list = g_list_prepend (NULL, layer);
+  gimp_image_set_selected_layers (image, list);
+  g_list_free (list);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  watch          = g_slice_new0 (NewAdjustmentWatch);
+  watch->gimp    = image->gimp;
+  watch->layer   = g_object_ref (layer);
+
+  g_signal_connect (layer, "filters-changed",
+                    G_CALLBACK (layers_new_adjustment_filters_changed),
+                    watch);
+  g_signal_connect (layer, "removed",
+                    G_CALLBACK (layers_new_adjustment_removed),
+                    watch);
+
+  /*  the adjustment's dialog, on the new layer (the selected drawable)  */
+  filter_value = g_variant_ref_sink (g_variant_new_string (GIMP_STRING_ACTION (filter_action)->value));
+  filters_apply_interactive_cmd_callback (filter_action, filter_value, data);
+  g_variant_unref (filter_value);
+
+  /*  settles right away when the dialog did not open (the layer goes)  */
+  if (! watch->idle_id)
+    watch->idle_id = g_idle_add (layers_new_adjustment_settled, watch);
+}
+
 void
 layers_new_group_cmd_callback (GimpAction *action,
                                GVariant   *value,
