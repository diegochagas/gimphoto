diff --git a/app/core/gimpimage-merge.c b/app/core/gimpimage-merge.c
index 8679900fb0..86f9a0d8b3 100644
--- a/app/core/gimpimage-merge.c
+++ b/app/core/gimpimage-merge.c
@@ -735,8 +735,30 @@ gimp_image_merge_layers (GimpImage     *image,
   if (parent)
     (void) gimp_filter_get_node (GIMP_FILTER (parent));
 
-  /*  Build our graph inside the top-layer's parent node  */
-  source_node = gimp_filter_get_node (GIMP_FILTER (top_layer));
+  /*  Build our graph inside the top-layer's parent node.
+   *  GIMPhoto: a clipped layer's node outputs only what was composited
+   *  onto its base; the whole composite comes out of the base's node.
+   */
+  {
+    GimpLayer *source_layer = top_layer;
+
+    while (gimp_layer_get_clipped (source_layer))
+      {
+        GimpContainer *container = gimp_item_get_container (GIMP_ITEM (source_layer));
+        gint           index     = gimp_item_get_index (GIMP_ITEM (source_layer));
+        GimpLayer     *below     = NULL;
+
+        if (container)
+          below = GIMP_LAYER (gimp_container_get_child_by_index (container, index + 1));
+
+        if (! below)
+          break;
+
+        source_layer = below;
+      }
+
+    source_node = gimp_filter_get_node (GIMP_FILTER (source_layer));
+  }
   node = gegl_node_get_parent (source_node);
 
   g_return_val_if_fail (node, NULL);
