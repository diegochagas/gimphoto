diff --git a/app/actions/layers-commands.c b/app/actions/layers-commands.c
index 66f9fe6efc..04ccfb25b3 100644
--- a/app/actions/layers-commands.c
+++ b/app/actions/layers-commands.c
@@ -2678,6 +2678,53 @@ layers_lock_position_cmd_callback (GimpAction *action,
   items_lock_position_cmd_callback (action, value, image, layers);
 }
 
+/*  GIMPhoto: Photoshop's Create / Release Clipping Mask on the selected
+ *  layers (the bottom layer of a group cannot be clipped)
+ */
+void
+layers_clipping_mask_cmd_callback (GimpAction *action,
+                                   GVariant   *value,
+                                   gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  GList     *iter;
+  gboolean   clipped;
+  gboolean   change = FALSE;
+  return_if_no_layers (image, layers, data);
+
+  clipped = g_variant_get_boolean (value);
+
+  for (iter = layers; iter; iter = iter->next)
+    {
+      if (clipped && ! gimp_layer_can_be_clipped (iter->data))
+        continue;
+
+      if (clipped != gimp_layer_get_clipped (iter->data))
+        change = TRUE;
+    }
+
+  if (! change)
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                               clipped ?
+                               _("Create Clipping Mask") :
+                               _("Release Clipping Mask"));
+
+  for (iter = layers; iter; iter = iter->next)
+    {
+      if (clipped && ! gimp_layer_can_be_clipped (iter->data))
+        continue;
+
+      if (clipped != gimp_layer_get_clipped (iter->data))
+        gimp_layer_set_clipped (iter->data, clipped, TRUE);
+    }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
 void
 layers_lock_alpha_cmd_callback (GimpAction *action,
                                 GVariant   *value,
