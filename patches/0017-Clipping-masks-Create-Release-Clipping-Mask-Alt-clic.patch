+/*  GIMPhoto: the bent arrow follows the layer's clipping  */
+static void
+gimp_layer_tree_view_clipped_changed (GimpLayer         *layer,
+                                      GimpLayerTreeView *layer_view)
+{
+  GimpContainerView     *view      = GIMP_CONTAINER_VIEW (layer_view);
+  GimpContainerTreeView *tree_view = GIMP_CONTAINER_TREE_VIEW (layer_view);
+  GtkTreeIter           *iter;
+
+  iter = _gimp_container_view_lookup (view, GIMP_VIEWABLE (layer));
+
+  if (iter)
+    gtk_tree_store_set (GTK_TREE_STORE (tree_view->model), iter,
+                        layer_view->priv->model_column_clipped,
+                        gimp_layer_get_clipped (layer),
+                        -1);
+}
+
+/*  GIMPhoto: Alt+click on the line between two layers clips the upper one
+ *  to the lower one, or releases it, as in Photoshop
+ */
+static gboolean
+gimp_layer_tree_view_gap_clicked (GimpContainerTreeView *tree_view,
+                                  GimpViewable          *upper,
+                                  GimpViewable          *lower)
+{
+  GimpLayer *layer;
+  GimpImage *image;
+
+  if (! GIMP_IS_LAYER (upper) || ! GIMP_IS_LAYER (lower))
+    return FALSE;
+
+  layer = GIMP_LAYER (upper);
+
+  if (gimp_item_get_parent (GIMP_ITEM (upper)) !=
+      gimp_item_get_parent (GIMP_ITEM (lower)))
+    return FALSE;
+
+  if (! gimp_layer_get_clipped (layer) && ! gimp_layer_can_be_clipped (layer))
+    return FALSE;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+
+  gimp_layer_set_clipped (layer, ! gimp_layer_get_clipped (layer), TRUE);
+  gimp_image_flush (image);
+
+  return TRUE;
+}
+
 static void
 gimp_layer_tree_view_mask_changed (GimpLayer         *layer,
                                    GimpLayerTreeView *layer_view)
