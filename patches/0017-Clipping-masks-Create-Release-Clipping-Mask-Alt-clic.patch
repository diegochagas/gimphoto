+
+/*  GIMPhoto: Photoshop's clipping masks.
+ *
+ *  A run of clipped layers above an unclipped layer (their base) is
+ *  composited onto the base's own pixels, each clipped layer with its own
+ *  mode, opacity and mask but confined to where the pixels below it in the
+ *  run are (Clip to backdrop), and the result stands in for the base's
+ *  pixels when the base is blended with the backdrop. In the stack's graph
+ *  that is: the base's "clip-base" output feeds the first clipped layer,
+ *  each clipped layer feeds the next, the last one feeds the base's
+ *  "clip-result" input, and the chain of unclipped layers skips the
+ *  clipped ones. GimpFilterStack builds the plain chain; this rewires it
+ *  whenever the stack or a clipping changes.
+ */
+
+static void
+gimp_layer_stack_graph_changed (GimpFilterStack *stack)
+{
+  gimp_layer_stack_update_clipping (GIMP_LAYER_STACK (stack));
+}
+
+static void
+gimp_layer_stack_layer_clipped (GimpLayer      *layer,
+                                GimpLayerStack *stack)
+{
+  gimp_layer_stack_update_clipping (stack);
+}
+
+static void
+gimp_layer_stack_update_clipping (GimpLayerStack *stack)
+{
+  GimpFilterStack *filter_stack = GIMP_FILTER_STACK (stack);
+  GList           *layers;
+  GList           *iter;
+  GList           *bases        = NULL;
+  GList           *redraw       = NULL;
+  GimpLayer       *base         = NULL;
+  gboolean         any_clipping = FALSE;
+  gboolean         changed      = FALSE;
+
+  layers = gimp_item_stack_get_item_iter (GIMP_ITEM_STACK (stack));
+
+  /*  the bases: the nearest active unclipped layer below an active clipped
+   *  one; walked bottom to top. A clipped layer with nothing below it to
+   *  clip to shows as an ordinary layer, as in Photoshop.
+   */
+  for (iter = g_list_last (layers); iter; iter = g_list_previous (iter))
+    {
+      GimpLayer *layer = iter->data;
+
+      if (! gimp_layer_get_clipped (layer))
+        {
+          /*  hidden or not: a hidden base hides its clipped layers  */
+          base = layer;
+        }
+      else if (base && gimp_filter_get_active (GIMP_FILTER (layer)))
+        {
+          if (! g_list_find (redraw, layer))
+            redraw = g_list_prepend (redraw, layer);
+
+          if (gimp_filter_get_active (GIMP_FILTER (base)))
+            {
+              any_clipping = TRUE;
+
+              if (! g_list_find (bases, base))
+                bases = g_list_prepend (bases, base);
+            }
+        }
+    }
+
+  for (iter = layers; iter; iter = g_list_next (iter))
+    {
+      GimpLayer *layer = iter->data;
+
+      if (layer->clip_base != (g_list_find (bases, layer) != NULL))
+        {
+          changed = TRUE;
+
+          if (! g_list_find (redraw, layer))
+            redraw = g_list_prepend (redraw, layer);
+        }
+    }
+
+  if (filter_stack->graph && (any_clipping || changed))
+    {
+      GeglNode *output = gegl_node_get_output_proxy (filter_stack->graph,
+                                                     "output");
+      GeglNode *previous;
+      GeglNode *clip_previous = NULL;
+      GimpLayer *last_clipped = NULL;
+
+      /*  every link of the chain goes, so no stale one can close a loop
+       *  when a base's node is wired
+       */
+      gegl_node_disconnect (output, "input");
+
+      for (iter = layers; iter; iter = g_list_next (iter))
+        {
+          GeglNode *node = gimp_filter_peek_node (iter->data);
+
+          if (! node)
+            continue;
+
+          gegl_node_disconnect (node, "input");
+
+          if (gegl_node_has_pad (node, "clip-result"))
+            gegl_node_disconnect (node, "clip-result");
+        }
+
+      for (iter = layers; iter; iter = g_list_next (iter))
+        _gimp_layer_set_clip_base (iter->data,
+                                   g_list_find (bases, iter->data) != NULL);
+
+      previous = gegl_node_get_input_proxy (filter_stack->graph, "input");
+      base     = NULL;
+
+      for (iter = g_list_last (layers); iter; iter = g_list_previous (iter))
+        {
+          GimpLayer *layer   = iter->data;
+          gboolean   clipped = gimp_layer_get_clipped (layer);
+          GeglNode  *node;
+
+          if (! gimp_filter_get_active (GIMP_FILTER (layer)))
+            {
+              if (! clipped)
+                base = layer;
+
+              continue;
+            }
+
+          node = gimp_filter_get_node (GIMP_FILTER (layer));
+
+          if (clipped && base && base->clip_base)
+            {
+              /*  onto the base, or the clipped layer below  */
+              gegl_node_link (clip_previous, node);
+              clip_previous = node;
+              last_clipped  = layer;
+            }
+          else if (clipped && base)
+            {
+              /*  a hidden base: hidden with it  */
+              continue;
+            }
+          else
+            {
+              if (last_clipped)
+                {
+                  gegl_node_connect (clip_previous, "output",
+                                     gimp_filter_get_node (GIMP_FILTER (base)),
+                                     "clip-result");
+                  last_clipped = NULL;
+                }
+
+              gegl_node_link (previous, node);
+              previous = node;
+              base     = layer;
+
+              if (layer->clip_base)
+                clip_previous = gegl_node_get_output_proxy (node, "clip-base");
+            }
+        }
+
+      if (last_clipped)
+        gegl_node_connect (clip_previous, "output",
+                           gimp_filter_get_node (GIMP_FILTER (base)),
+                           "clip-result");
+
+      gegl_node_link (previous, output);
+    }
+  else
+    {
+      for (iter = layers; iter; iter = g_list_next (iter))
+        _gimp_layer_set_clip_base (iter->data,
+                                   g_list_find (bases, iter->data) != NULL);
+    }
+
+  /*  redraw what the clipping covers  */
+  if (changed)
+    {
+      for (iter = redraw; iter; iter = g_list_next (iter))
+        {
+          GimpItem      *item = iter->data;
+          GeglRectangle  bounding_box;
+
+          bounding_box = gimp_drawable_get_bounding_box (GIMP_DRAWABLE (item));
+          bounding_box.x += gimp_item_get_offset_x (item);
+          bounding_box.y += gimp_item_get_offset_y (item);
+          gimp_drawable_stack_update (GIMP_DRAWABLE_STACK (stack),
+                                      bounding_box.x,     bounding_box.y,
+                                      bounding_box.width, bounding_box.height);
+        }
+    }
+
+  g_list_free (bases);
+  g_list_free (redraw);
+}
