+/*  GIMPhoto: Photoshop's clipping masks  */
+
+#define GIMPHOTO_CLIPPED_PARASITE "gimphoto-clipped"
+
+void
+gimp_layer_set_clipped (GimpLayer *layer,
+                        gboolean   clipped,
+                        gboolean   push_undo)
+{
+  g_return_if_fail (GIMP_IS_LAYER (layer));
+
+  clipped = clipped ? TRUE : FALSE;
+
+  if (layer->clipped != clipped)
+    {
+      if (push_undo && gimp_item_is_attached (GIMP_ITEM (layer)))
+        {
+          GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+
+          gimp_image_undo_push_layer_clipped (image,
+                                              clipped ?
+                                              C_("undo-type", "Create Clipping Mask") :
+                                              C_("undo-type", "Release Clipping Mask"),
+                                              layer);
+        }
+
+      layer->clipped = clipped;
+
+      /*  the parasite mirrors the flag: it is what plug-ins (the PSD
+       *  loader and exporter) and the XCF carry
+       */
+      if (clipped)
+        {
+          if (! gimp_item_parasite_find (GIMP_ITEM (layer),
+                                         GIMPHOTO_CLIPPED_PARASITE))
+            {
+              GimpParasite *parasite;
+
+              parasite = gimp_parasite_new (GIMPHOTO_CLIPPED_PARASITE,
+                                            GIMP_PARASITE_PERSISTENT,
+                                            1, "1");
+              gimp_item_parasite_attach (GIMP_ITEM (layer), parasite, FALSE);
+              gimp_parasite_free (parasite);
+            }
+        }
+      else if (gimp_item_parasite_find (GIMP_ITEM (layer),
+                                        GIMPHOTO_CLIPPED_PARASITE))
+        {
+          gimp_item_parasite_detach (GIMP_ITEM (layer),
+                                     GIMPHOTO_CLIPPED_PARASITE, FALSE);
+        }
+
+      g_signal_emit (layer, layer_signals[CLIPPED_CHANGED], 0);
+
+      gimp_layer_update_effective_mode (layer);
+      gimp_layer_update_excludes_backdrop (layer);
+
+      gimp_drawable_update (GIMP_DRAWABLE (layer), 0, 0, -1, -1);
+    }
+}
+
+gboolean
+gimp_layer_get_clipped (GimpLayer *layer)
+{
+  g_return_val_if_fail (GIMP_IS_LAYER (layer), FALSE);
+
+  return layer->clipped;
+}
+
+/*  a layer can be clipped when there is a layer below it in its group
+ *  (Photoshop greys Create Clipping Mask out for the bottom layer)
+ */
+gboolean
+gimp_layer_can_be_clipped (GimpLayer *layer)
+{
+  GimpContainer *container;
+  gint           index;
+
+  g_return_val_if_fail (GIMP_IS_LAYER (layer), FALSE);
+
+  if (gimp_layer_is_floating_sel (layer) ||
+      ! gimp_item_is_attached (GIMP_ITEM (layer)))
+    return FALSE;
+
+  container = gimp_item_get_container (GIMP_ITEM (layer));
+  index     = gimp_item_get_index (GIMP_ITEM (layer));
+
+  return (container != NULL &&
+          index >= 0 &&
+          index < gimp_container_get_n_children (container) - 1);
+}
+
+/*  The base of a clipping run composites the clipped layers onto its own
+ *  pixels before blending the result with the backdrop, with its mode,
+ *  opacity and mask: its node gets an extra "clip-base" output (its own
+ *  pixels, Normal over nothing, masked) and a "clip-result" input (what
+ *  the stack composited onto them), which takes the place of the layer's
+ *  pixels at its mode node. GimpLayerStack wires the two.
+ */
+void
+_gimp_layer_set_clip_base (GimpLayer *layer,
+                           gboolean   clip_base)
+{
+  g_return_if_fail (GIMP_IS_LAYER (layer));
+
+  clip_base = clip_base ? TRUE : FALSE;
+
+  if (layer->clip_base != clip_base)
+    {
+      layer->clip_base = clip_base;
+
+      if (gimp_filter_peek_node (GIMP_FILTER (layer)))
+        gimp_layer_update_clip_base_node (layer);
+    }
+}
+
+static void
+gimp_layer_clip_base_mask_changed (GimpLayer *layer)
+{
+  /*  the mask code wires the mode node's aux pads afresh  */
+  if (layer->clip_base && gimp_filter_peek_node (GIMP_FILTER (layer)))
+    gimp_layer_update_clip_base_node (layer);
+}
+
+static void
+gimp_layer_update_clip_base_node (GimpLayer *layer)
+{
+  GeglNode *node      = gimp_filter_get_node (GIMP_FILTER (layer));
+  GeglNode *mode_node = gimp_drawable_get_mode_node (GIMP_DRAWABLE (layer));
+  gboolean  show_mask = (layer->mask && gimp_layer_get_show_mask (layer));
+  gboolean  use_mask  = (layer->mask && ! show_mask &&
+                         gimp_layer_get_apply_mask (layer));
+
+  /*  a floating selection's source node belongs to its drawable  */
+  if (! layer->layer_offset_node)
+    return;
+
+  if (layer->clip_base && ! show_mask)
+    {
+      GeglNode *clip_base;
+      GeglNode *clip_result;
+
+      if (! layer->clip_mode_node)
+        {
+          layer->clip_mode_node = gegl_node_new_child (node,
+                                                       "operation", "gimp:normal",
+                                                       NULL);
+          gimp_gegl_mode_node_set_mode (layer->clip_mode_node,
+                                        GIMP_LAYER_MODE_NORMAL,
+                                        GIMP_LAYER_COLOR_SPACE_AUTO,
+                                        GIMP_LAYER_COLOR_SPACE_AUTO,
+                                        GIMP_LAYER_COMPOSITE_UNION);
+          gimp_gegl_mode_node_set_opacity (layer->clip_mode_node, 1.0);
+        }
+
+      /*  the layer's own pixels, over nothing, with its mask  */
+      gegl_node_disconnect (layer->clip_mode_node, "input");
+      gegl_node_connect (show_mask ?
+                         layer->mask_offset_node : layer->layer_offset_node,
+                         "output",
+                         layer->clip_mode_node, "aux");
+      if (use_mask)
+        gegl_node_connect (layer->mask_offset_node, "output",
+                           layer->clip_mode_node, "aux2");
+      else
+        gegl_node_disconnect (layer->clip_mode_node, "aux2");
+
+      clip_base = gegl_node_get_output_proxy (node, "clip-base");
+      gegl_node_connect (layer->clip_mode_node, "output",
+                         clip_base,             "input");
+
+      /*  what was composited onto them stands in for the layer  */
+      clip_result = gegl_node_get_input_proxy (node, "clip-result");
+      gegl_node_connect (clip_result, "output",
+                         mode_node,   "aux");
+      if (use_mask)
+        gegl_node_disconnect (mode_node, "aux2");
+    }
+  else
+    {
+      if (layer->clip_mode_node)
+        {
+          gegl_node_disconnect (layer->clip_mode_node, "aux");
+          gegl_node_disconnect (layer->clip_mode_node, "aux2");
+        }
+
+      /*  back to GIMP's wiring (also while the mask is shown: the mask
+       *  alone, as Photoshop)
+       */
+      gegl_node_connect (show_mask ?
+                         layer->mask_offset_node : layer->layer_offset_node,
+                         "output",
+                         mode_node, "aux");
+      if (use_mask)
+        gegl_node_connect (layer->mask_offset_node, "output",
+                           mode_node,               "aux2");
+      else
+        gegl_node_disconnect (mode_node, "aux2");
+    }
+}
