index 2bb4b28df3..3224ac8fae 100644
--- a/menus/image-menu.ui.in.in
+++ b/menus/image-menu.ui.in.in
@@ -432,6 +432,7 @@
             <item><attribute name="action">app.layers-new-adjustment-levels</attribute></item>
             <item><attribute name="action">app.layers-new-adjustment-curves</attribute></item>
             <item><attribute name="action">app.layers-new-adjustment-exposure</attribute></item>
+            <item><attribute name="action">app.layers-new-adjustment-vibrance</attribute></item>
             <item><attribute name="action">app.layers-new-adjustment-hue-saturation</attribute></item>
             <item><attribute name="action">app.layers-new-adjustment-color-balance</attribute></item>
             <item><attribute name="action">app.layers-new-adjustment-mono-mixer</attribute></item>
@@ -573,6 +574,7 @@
         <item><attribute name="action">app.filters-hue-chroma</attribute></item>
         <item><attribute name="action">app.filters-hue-saturation</attribute></item>
         <item><attribute name="action">app.filters-saturation</attribute></item>
+        <item><attribute name="action">app.filters-vibrance</attribute></item>
         <item><attribute name="action">app.filters-exposure</attribute></item>
         <item><attribute name="action">app.filters-shadows-highlights</attribute></item>
         <item><attribute name="action">app.filters-brightness-contrast</attribute></item>
