#!/usr/bin/env bash
# Smoke test of the installed GIMPhoto build (after scripts/build):
#   - it starts, headless, and runs a Python plug-in batch command;
#   - it is the GIMP version Flathub's recipe pins;
#   - it uses its own user profile (~/.var/app/<app id>/config/GIMPhoto), not
#     the official GIMP's ~/.config/GIMP/3.x, so it starts as plain GIMP; and
#     that folder really is the per-app one on the host (Flathub's
#     xdg-config/GIMP permission mounts the host's ~/.config/GIMP over
#     ~/.var/app/<app id>/config/GIMP inside the sandbox);
#   - its launcher is named GIMPhoto and runs a flatpak the host has (the
#     applications menu hides a launcher whose program does not exist);
#   - the plug-ins it ships (plugins/) are registered, e.g. the Layer Style
#     procedures the Layers panel's fx button runs;
#   - GIMPhoto's GEGL operations (gegl/) draw Gradient and Pattern Overlay,
#     also after saving and reopening an XCF;
#   - PSD keeps text editable both ways: a GIMP text layer with a Layer
#     Style exported to PSD is a Photoshop Type layer with its effects, and
#     opens again as an editable text layer with its Layer Style;
#   - Layer via Copy / Cut (Ctrl+J / Ctrl+Shift+J) work on a selection;
#   - Merge Layers (Ctrl+E): several selected layers into one, one layer
#     down, a group, layers inside a group;
#   - Smart Objects: layers become one link layer showing an XCF next to the
#     image, scaled down and back up it stays sharp, a PSD keeps it as a
#     Photoshop smart object (upright and rotated) and opens it as one
#     again, Replace Contents works;
#   - the local ComfyUI (the `comfyui` user service, when this machine has
#     it) is left alone by runs without a user interface, and the sandbox
#     may talk to the user's systemd to start and stop it with GIMPhoto;
#   - Select Subject, Object Selection, Remove Background, Generative Fill,
#     Generate Image, the Remove tool, Photo Restoration and Modern Photo
#     (AI), without the local AI, say where to install it and leave the
#     selection and the layers alone (no ComfyUI is called); the Object
#     Selection and Remove tools are compiled in; a Generative Fill layer keeps its variations
#     through an XCF save and can be changed again; Photo Restoration's
#     damage mask runs on the numpy, scipy and Pillow shipped in the app;
#     Modern Photo tells black and white photos from colour ones;
#   - Quick Selection: GEGL's paint-select, built by GIMPhoto, grows a
#     stroke to the edges of what it is painted on, and GIMP's Paint Select
#     is compiled in as Quick Selection (painting with it needs the GUI);
#   - GIMPhoto's Properties panel is compiled in and in the default layout;
#   - adjustment layers are compiled in and an XCF with one applies its
#     adjustment to the layer below, through its mask, also after a save;
#   - a profile saved before a default shortcut moved (Ctrl+E to Merge
#     Layers) gets the move once, keeping its own shortcuts;
#   - a profile with a layout saved before GIMPhoto's current default gets
#     the default at the next start, its own moved aside (needs the GUI);
#   - GIMPhoto's shape tools are compiled in (drawing with it needs the GUI);
#   - it ships GIMPhoto's Photoshop-style toolbox, layout and settings over
#     GIMP's system ones, a new profile gets them, and GIMPhoto's splash
#     screen and icon replace GIMP's;
#   - it ships GIMPhoto's default shortcuts (defaults/shortcutsrc) where its
#     patched GIMP looks for them.
# Exit 0 when all hold. Needs a display (or xvfb-run, as in CI).
set -euo pipefail
cd "$(dirname "$0")/.."

app="io.github.diegochagas.GIMPhoto"
# one procedure per shipped plug-in that a feature depends on
procedures=(layer-style-dialog layer-style-drop-shadow gimphoto-layer-via-copy gimphoto-layer-via-cut gimphoto-merge-layers file-psd-text-load file-psd-text-export smart-object-convert smart-object-edit smart-object-replace gimphoto-comfyui-service gimphoto-select-subject gimphoto-object-select gimphoto-remove-background gimphoto-generative-fill gimphoto-generate-image gimphoto-generative-edit gimphoto-remove gimphoto-photo-restoration gimphoto-modern-photo)
want="$(python3 tools/upstream_info.py gimp-version)"
report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
trap 'rm -f "$report"' EXIT

if ! flatpak info --user "$app" >/dev/null 2>&1; then
    echo "FAIL $app is not installed: run scripts/build" >&2
    exit 1
fi

# the local ComfyUI's starts and stops from now on: a batch run that started
# it would also stop it on quit, so its state alone proves nothing, but
# systemd's journal keeps both
smoke_started_at="$(date +%s)"
comfyui_events() {
    journalctl --user -u comfyui --since "@$smoke_started_at" -o cat --no-pager 2>/dev/null |
        grep -cE '^(Starting|Started|Stopping) comfyui\.service' || true
}

# -i no UI, -d no data loading; fonts stay on (text layers need them)
flatpak run "$app" -i -d --batch-interpreter=python-fu-eval \
    -b "open(Gimp.directory() + '/gimphoto-smoke-marker', 'w').write('x')" \
    -b "open('$report', 'w').write(Gimp.version() + '\n' + Gimp.directory() + '\n' + ' '.join(p for p in '${procedures[*]}'.split() if not Gimp.get_pdb().procedure_exists(p)) + '\n')" \
    --quit >/dev/null 2>&1 || true

status=0
version="$(sed -n 1p "$report")"
profile="$(sed -n 2p "$report")"
if [[ "$version" == "$want" ]]; then
    echo "ok   starts and runs Python batch: GIMP $version"
else
    echo "FAIL expected GIMP $want, got '${version:-nothing}' (did it start?)" >&2
    status=1
fi
own_profile="$HOME/.var/app/$app/config/GIMPhoto"
# a file written to GIMP's profile from inside must show up there on the host
marker="$own_profile/gimphoto-smoke-marker"
marker_seen=false
if [[ -e "$marker" ]]; then
    marker_seen=true
    rm -f "$marker"
fi
if [[ "$profile" == "$own_profile" && "$marker_seen" == true ]]; then
    echo "ok   own user profile: $profile"
elif [[ "$profile" == "$own_profile" ]]; then
    echo "FAIL the profile path is right inside the sandbox, but a file GIMP wrote there is not in $own_profile on the host" >&2
    status=1
else
    echo "FAIL expected GIMPhoto's own profile, got '${profile:-nothing}'" >&2
    status=1
fi
missing="$(sed -n 3p "$report")"
if [[ -n "$version" && -z "$missing" ]]; then
    echo "ok   shipped plug-ins registered: ${procedures[*]}"
else
    echo "FAIL plug-in procedures not registered: ${missing:-${procedures[*]}}" >&2
    status=1
fi
# Layer Style effects on an opaque layer without alpha (regression test)
style_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$style_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_layer_style.py').read())" --quit >/dev/null 2>&1 || true
style_result="$(cat "$style_report")"
rm -f "$style_report"
if [[ "$style_result" == ok ]]; then
    echo "ok   layer style draws outside an opaque layer without alpha, with a selection"
else
    echo "FAIL layer style on a layer without alpha: ${style_result:-did not run}" >&2
    status=1
fi
installed_keys="$(flatpak run --command=cat "$app" /app/share/gimp/3.0/gimphoto/shortcutsrc 2>/dev/null || true)"
if [[ -n "$installed_keys" && "$installed_keys" == "$(cat defaults/shortcutsrc)" ]]; then
    echo "ok   default shortcuts installed: Photoshop's"
else
    echo "FAIL /app/share/gimp/3.0/gimphoto/shortcutsrc is missing or not defaults/shortcutsrc" >&2
    status=1
fi
# Gradient / Pattern Overlay: GIMPhoto's GEGL operations and the plug-in
overlays_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$overlays_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_overlays.py').read())" --quit >/dev/null 2>&1 || true
overlays_result="$(cat "$overlays_report")"
rm -f "$overlays_report"
if [[ "$overlays_result" == ok ]]; then
    echo "ok   gradient / pattern overlay (GEGL operations, XCF, Layer Style)"
else
    echo "FAIL gradient / pattern overlay: ${overlays_result:-did not run}" >&2
    status=1
fi
# PSD with editable text, both ways (GIMPhoto's Node and ag-psd)
psd_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$psd_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_psd_text.py').read())" --quit >/dev/null 2>&1 || true
psd_result="$(cat "$psd_report")"
rm -f "$psd_report"
if [[ "$psd_result" == ok ]]; then
    echo "ok   PSD keeps text editable both ways (Type layer + Layer Style)"
else
    echo "FAIL PSD with editable text: ${psd_result:-did not run}" >&2
    status=1
fi
# Layer via Copy / Cut (Ctrl+J / Ctrl+Shift+J) with and without a selection
via_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$via_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_layer_via.py').read())" --quit >/dev/null 2>&1 || true
via_result="$(cat "$via_report")"
rm -f "$via_report"
if [[ "$via_result" == ok ]]; then
    echo "ok   layer via copy / cut"
else
    echo "FAIL layer via copy / cut: ${via_result:-did not run}" >&2
    status=1
fi
# Smart Objects: convert, scale non-destructively, replace contents
so_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$so_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_smart_objects.py').read())" --quit >/dev/null 2>&1 || true
so_result="$(cat "$so_report")"
rm -f "$so_report"
if [[ "$so_result" == ok ]]; then
    echo "ok   smart objects (convert, non-destructive scale, PSD both ways, replace contents)"
else
    echo "FAIL smart objects: ${so_result:-did not run}" >&2
    status=1
fi
# ComfyUI with GIMPhoto: the sandbox may reach the user's systemd, and the
# batch runs above (no user interface) did not start or stop ComfyUI
if flatpak info --user --show-permissions "$app" 2>/dev/null | grep -q 'org.freedesktop.systemd1=talk'; then
    comfyui_changes="$(comfyui_events)"
    if [[ "$comfyui_changes" == 0 ]]; then
        echo "ok   ComfyUI service: reachable from the sandbox, not started by batch runs"
    else
        echo "FAIL the comfyui service was started or stopped $comfyui_changes time(s) during the batch runs" >&2
        status=1
    fi
else
    echo "FAIL the sandbox cannot talk to org.freedesktop.systemd1 (finish-args)" >&2
    status=1
fi
# Select Subject (AI) without the local AI: a clear message, no change
subject_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$subject_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_select_subject.py').read())" --quit >/dev/null 2>&1 || true
subject_result="$(cat "$subject_report")"
rm -f "$subject_report"
if [[ "$subject_result" == ok ]]; then
    echo "ok   AI commands (Select Subject, Object Selection, Remove Background, Generative Fill, Generate Image, Remove tool, Photo Restoration, Modern Photo) without the local AI say where to install it, nothing changed"
else
    echo "FAIL AI selections without the local AI: ${subject_result:-did not run}" >&2
    status=1
fi
# Photo Restoration's damage mask: numpy, scipy and Pillow in the app
restore_result=$(flatpak run --filesystem="$PWD/tests:ro" --command=python3 "$app" "$PWD/tests/smoke_restore_mask.py" 2>&1 | tail -n 1)
if [[ "$restore_result" == ok ]]; then
    echo "ok   Photo Restoration's damage mask runs on the app's numpy, scipy and Pillow"
else
    echo "FAIL Photo Restoration's damage mask: ${restore_result:-did not run}" >&2
    status=1
fi
# Generative Fill's layer keeps its variations through an XCF (no AI called)
generative_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$generative_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_generative_layer.py').read())" --quit >/dev/null 2>&1 || true
generative_result="$(cat "$generative_report")"
rm -f "$generative_report"
if [[ "$generative_result" == ok ]]; then
    echo "ok   a Generative Fill layer keeps its variations in the XCF and can be changed again"
else
    echo "FAIL Generative Fill layer: ${generative_result:-did not run}" >&2
    status=1
fi
# Merge Layers (Ctrl+E): several layers, one layer, a group, inside a group
merge_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$merge_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_merge_layers.py').read())" --quit >/dev/null 2>&1 || true
merge_result="$(cat "$merge_report")"
rm -f "$merge_report"
if [[ "$merge_result" == ok ]]; then
    echo "ok   Merge Layers: several layers into one (top's name), one layer down, a group, inside a group"
else
    echo "FAIL Merge Layers: ${merge_result:-did not run}" >&2
    status=1
fi
# Modern Photo's black-and-white check on GIMP images (no AI called)
modern_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$modern_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_modern_photo.py').read())" --quit >/dev/null 2>&1 || true
modern_result="$(cat "$modern_report")"
rm -f "$modern_report"
if [[ "$modern_result" == ok ]]; then
    echo "ok   Modern Photo tells black and white (Grayscale mode, sepia) from colour photos"
else
    echo "FAIL Modern Photo's black-and-white check: ${modern_result:-did not run}" >&2
    status=1
fi
# Adjustment layers: compiled in, and an XCF with one applies its Invert to
# the layer below through its mask, also after saving and reopening
adjustment_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --filesystem="$PWD/tests:ro" --env=GIMPHOTO_SMOKE_OUT="$adjustment_report" \
    --env=GIMPHOTO_ADJUSTMENT_XCF="$PWD/tests/fixtures/adjustment-layer.xcf" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_adjustment_layer.py').read())" --quit >/dev/null 2>&1 || true
adjustment_result="$(cat "$adjustment_report")"
rm -f "$adjustment_report"
if [[ "$adjustment_result" == ok ]] &&
    flatpak run --command=sh "$app" -c 'grep -q "New Adjustment Layer" /app/bin/gimp-3.*' 2>/dev/null; then
    echo "ok   adjustment layers: compiled in; an Invert adjustment layer applies to the layer below through its mask, also after an XCF save"
else
    echo "FAIL adjustment layers: ${adjustment_result:-the actions are not in GIMP}" >&2
    status=1
fi
if flatpak run --command=sh "$app" -c 'grep -q gimp-remove-tool /app/bin/gimp-3.*' 2>/dev/null; then
    echo "ok   Remove tool compiled in"
else
    echo "FAIL the Remove tool (gimp-remove-tool) is not in GIMP" >&2
    status=1
fi
if flatpak run --command=sh "$app" -c 'grep -q gimp-object-select-tool /app/bin/gimp-3.*' 2>/dev/null; then
    echo "ok   Object Selection tool compiled in"
else
    echo "FAIL the Object Selection tool (gimp-object-select-tool) is not in GIMP" >&2
    status=1
fi
paint_select=$(flatpak run --filesystem="$PWD/tests:ro" --command=python3 "$app" "$PWD/tests/smoke_paint_select.py" 2>/dev/null | tail -n 1)
if [ "$paint_select" = ok ] &&
    flatpak run --command=sh "$app" -c 'grep -q "Quick Selection Tool" /app/bin/gimp-3.*' 2>/dev/null; then
    echo "ok   Quick Selection: gegl:paint-select grows a stroke to its edges; the tool is compiled in"
else
    echo "FAIL Quick Selection: ${paint_select:-the tool is not in GIMP}" >&2
    status=1
fi
if flatpak run --command=sh "$app" -c 'grep -q gimp-properties-editor /app/bin/gimp-3.*' 2>/dev/null &&
    grep -q '(dockable "gimp-properties-editor"' defaults/sessionrc; then
    echo "ok   Properties panel compiled in and in the default layout"
else
    echo "FAIL the Properties panel (gimp-properties-editor) is not in GIMP or not in defaults/sessionrc" >&2
    status=1
fi
# Default layout updates: a profile holding an older saved layout (no layout
# version yet) starts with GIMPhoto's default, its own moved aside
layout_profile="$(mktemp -d /tmp/gimphoto-smoke.XXXXXX)"
layout_version="$(sed -n 's/^# gimphoto-layout-version \([0-9]*\)$/\1/p' defaults/sessionrc)"
printf '# an older saved layout\n(hide-docks no)\n' >"$layout_profile/sessionrc"
flatpak run --env=GIMP3_DIRECTORY="$layout_profile" --env=GIMPHOTO_COMFYUI=off "$app" --batch-interpreter=python-fu-eval \
    -b "Gimp.displays_flush()" --quit >/dev/null 2>&1 || true
if grep -q "an older saved layout" "$layout_profile/sessionrc-before-layout-$layout_version" 2>/dev/null &&
    [[ "$(cat "$layout_profile/gimphoto-layout-version" 2>/dev/null)" == "$layout_version" ]] &&
    ! grep -q "an older saved layout" "$layout_profile/sessionrc" 2>/dev/null; then
    echo "ok   an older saved layout is replaced by the default (version $layout_version), and kept aside"
else
    echo "FAIL a profile's older saved layout was not replaced by layout version ${layout_version:-?}" >&2
    status=1
fi
rm -rf "$layout_profile"
# ... and a profile already on that version keeps its own layout
layout_profile="$(mktemp -d /tmp/gimphoto-smoke.XXXXXX)"
printf '# my own layout\n(hide-docks no)\n' >"$layout_profile/sessionrc"
printf '%s\n' "$layout_version" >"$layout_profile/gimphoto-layout-version"
flatpak run --env=GIMP3_DIRECTORY="$layout_profile" --env=GIMPHOTO_COMFYUI=off "$app" --batch-interpreter=python-fu-eval \
    -b "Gimp.displays_flush()" --quit >/dev/null 2>&1 || true
if [[ ! -e "$layout_profile/sessionrc-before-layout-$layout_version" ]]; then
    echo "ok   a profile already on layout version $layout_version keeps its own layout"
else
    echo "FAIL a profile already on layout version $layout_version had its layout replaced" >&2
    status=1
fi
rm -rf "$layout_profile"
# Default shortcut updates: a profile saved before a move (Ctrl+E on Merge
# Down) gets it once, keeping its own shortcuts...
shortcuts_profile="$(mktemp -d /tmp/gimphoto-smoke.XXXXXX)"
printf '(file-version 1)\n(action "layers-merge-down" "<Primary>e")\n(action "select-all" "<Primary><Alt>a")\n' \
    >"$shortcuts_profile/shortcutsrc"
flatpak run --env=GIMP3_DIRECTORY="$shortcuts_profile" --env=GIMPHOTO_COMFYUI=off "$app" --batch-interpreter=python-fu-eval \
    -b "Gimp.displays_flush()" --quit >/dev/null 2>&1 || true
moved_ok=0
if grep -q '^(action "gimphoto-merge-layers" "<Primary>e")' "$shortcuts_profile/shortcutsrc" 2>/dev/null &&
    ! grep -q '^(action "layers-merge-down" "<Primary>e")' "$shortcuts_profile/shortcutsrc" &&
    grep -q '^(action "select-all" "<Primary><Alt>a")' "$shortcuts_profile/shortcutsrc" &&
    [[ -s "$shortcuts_profile/gimphoto-shortcuts-version" ]]; then
    moved_ok=1
fi
rm -rf "$shortcuts_profile"
# ... and one where the person put Ctrl+E elsewhere keeps it there
shortcuts_profile="$(mktemp -d /tmp/gimphoto-smoke.XXXXXX)"
printf '(file-version 1)\n(action "layers-merge-down" "<Primary>k")\n(action "select-none" "<Primary>e")\n' \
    >"$shortcuts_profile/shortcutsrc"
flatpak run --env=GIMP3_DIRECTORY="$shortcuts_profile" --env=GIMPHOTO_COMFYUI=off "$app" --batch-interpreter=python-fu-eval \
    -b "Gimp.displays_flush()" --quit >/dev/null 2>&1 || true
if ((moved_ok)) && grep -q '^(action "select-none" "<Primary>e")' "$shortcuts_profile/shortcutsrc" 2>/dev/null &&
    ! grep -q '^(action "gimphoto-merge-layers" "<Primary>e")' "$shortcuts_profile/shortcutsrc"; then
    echo "ok   a moved default shortcut (Ctrl+E) reaches a saved profile once; its own shortcuts are kept"
else
    echo "FAIL default shortcut moves: Ctrl+E did not move to Merge Layers, or a person's own shortcuts changed" >&2
    status=1
fi
rm -rf "$shortcuts_profile"
if flatpak run --command=sh "$app" -c 'grep -q gimp-shape-rectangle-tool /app/bin/gimp-3.*' 2>/dev/null; then
    echo "ok   shape tools compiled in"
else
    echo "FAIL the shape tools (gimp-shape-rectangle-tool...) are not in GIMP" >&2
    status=1
fi
# Photoshop-style defaults (toolbox, layout, settings) and branding
defaults_ok=true
for f in sessionrc toolrc; do
    if [[ "$(flatpak run --command=cat "$app" "/app/etc/gimp/3.0/$f" 2>/dev/null)" != "$(cat "defaults/$f")" ]]; then
        echo "FAIL /app/etc/gimp/3.0/$f is not defaults/$f" >&2
        defaults_ok=false
    fi
done
fresh="$(mktemp -d /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMP3_DIRECTORY="$fresh" "$app" -i -d --batch-interpreter=python-fu-eval \
    -b "open('$fresh/answer', 'w').write(Gimp.gimprc_query('layer-preview-size') + ' ' + Gimp.gimprc_query('import-add-alpha') + ' ' + Gimp.gimprc_query('theme'))" \
    --quit >/dev/null 2>&1 || true
answer="$(cat "$fresh/answer" 2>/dev/null || true)"
rm -rf "$fresh"
if [[ "$answer" != "extra-large yes Photoshop" ]]; then
    echo "FAIL a new profile does not get GIMPhoto's gimprc settings (got '${answer:-nothing}')" >&2
    defaults_ok=false
fi
if [[ "$(flatpak run --command=cat "$app" /app/share/gimp/3.0/themes/Photoshop/gimp-dark.css 2>/dev/null)" != "$(cat themes/Photoshop/gimp.css)" ]]; then
    echo "FAIL the Photoshop theme is not installed from themes/Photoshop/gimp.css" >&2
    defaults_ok=false
fi
if ! flatpak run --command=cat "$app" /app/share/gimp/3.0/images/gimp-splash.png 2>/dev/null | cmp -s - branding/splash.png; then
    echo "FAIL the splash screen is not branding/splash.png" >&2
    defaults_ok=false
fi
icon="$(flatpak info --user --show-location "$app")/export/share/icons/hicolor/256x256/apps/$app.png"
if ! cmp -s "$icon" branding/icons/256.png; then
    echo "FAIL the launcher icon is not branding/icons/256.png" >&2
    defaults_ok=false
fi
if [[ "$defaults_ok" == true ]]; then
    echo "ok   Photoshop-style toolbox, layout, theme and settings for new profiles; GIMPhoto splash and icon"
else
    status=1
fi
desktop="$(flatpak run --command=cat "$app" "/app/share/applications/$app.desktop" 2>/dev/null || true)"
if grep -qx "Name=GIMPhoto" <<<"$desktop"; then
    echo "ok   launcher name: GIMPhoto"
else
    echo "FAIL launcher is not named GIMPhoto" >&2
    status=1
fi
launcher="$(flatpak info --user --show-location "$app")/export/share/applications/$app.desktop"
exec_bin="$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$launcher" 2>/dev/null | head -1)"
if [[ -n "$exec_bin" && -x "$exec_bin" ]]; then
    echo "ok   launcher runs $exec_bin (shown in the applications menu)"
else
    echo "FAIL launcher runs '${exec_bin:-nothing}', which this system does not have: the menu hides it" >&2
    status=1
fi
exit $status
