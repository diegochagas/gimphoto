#!/usr/bin/env bash
# Smoke test of the installed GIMPhoto build (after scripts/build):
#   - it starts, headless, and runs a Python plug-in batch command;
#   - it is the GIMP version Flathub's recipe pins;
#   - it uses its own user profile (~/.var/app/<app id>/config/GIMPhoto), not
#     the official GIMP's ~/.config/GIMP/3.x, so it starts as plain GIMP; and
#     that folder really is the per-app one on the host (Flathub's
#     xdg-config/GIMP permission mounts the host's ~/.config/GIMP over
#     ~/.var/app/<app id>/config/GIMP inside the sandbox);
#   - its launcher is named GIMPhoto and runs a flatpak the host has (the
#     applications menu hides a launcher whose program does not exist);
#   - the plug-ins it ships (plugins/) are registered, e.g. the Layer Style
#     procedures the Layers panel's fx button runs;
#   - GIMPhoto's GEGL operations (gegl/) draw Gradient and Pattern Overlay,
#     also after saving and reopening an XCF;
#   - PSD keeps text editable both ways: a GIMP text layer with a Layer
#     Style exported to PSD is a Photoshop Type layer with its effects, and
#     opens again as an editable text layer with its Layer Style;
#   - Layer via Copy / Cut (Ctrl+J / Ctrl+Shift+J) work on a selection;
#   - GIMPhoto's shape tools are compiled in (drawing with it needs the GUI);
#   - it ships GIMPhoto's Photoshop-style toolbox, layout and settings over
#     GIMP's system ones, a new profile gets them, and GIMPhoto's splash
#     screen and icon replace GIMP's;
#   - it ships GIMPhoto's default shortcuts (defaults/shortcutsrc) where its
#     patched GIMP looks for them.
# Exit 0 when all hold. Needs a display (or xvfb-run, as in CI).
set -euo pipefail
cd "$(dirname "$0")/.."

app="io.github.diegochagas.GIMPhoto"
# one procedure per shipped plug-in that a feature depends on
procedures=(layer-style-dialog layer-style-drop-shadow gimphoto-layer-via-copy gimphoto-layer-via-cut file-psd-text-load file-psd-text-export)
want="$(python3 tools/upstream_info.py gimp-version)"
report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
trap 'rm -f "$report"' EXIT

if ! flatpak info --user "$app" >/dev/null 2>&1; then
    echo "FAIL $app is not installed: run scripts/build" >&2
    exit 1
fi

# -i no UI, -d no data loading; fonts stay on (text layers need them)
flatpak run "$app" -i -d --batch-interpreter=python-fu-eval \
    -b "open(Gimp.directory() + '/gimphoto-smoke-marker', 'w').write('x')" \
    -b "open('$report', 'w').write(Gimp.version() + '\n' + Gimp.directory() + '\n' + ' '.join(p for p in '${procedures[*]}'.split() if not Gimp.get_pdb().procedure_exists(p)) + '\n')" \
    --quit >/dev/null 2>&1 || true

status=0
version="$(sed -n 1p "$report")"
profile="$(sed -n 2p "$report")"
if [[ "$version" == "$want" ]]; then
    echo "ok   starts and runs Python batch: GIMP $version"
else
    echo "FAIL expected GIMP $want, got '${version:-nothing}' (did it start?)" >&2
    status=1
fi
own_profile="$HOME/.var/app/$app/config/GIMPhoto"
# a file written to GIMP's profile from inside must show up there on the host
marker="$own_profile/gimphoto-smoke-marker"
marker_seen=false
if [[ -e "$marker" ]]; then
    marker_seen=true
    rm -f "$marker"
fi
if [[ "$profile" == "$own_profile" && "$marker_seen" == true ]]; then
    echo "ok   own user profile: $profile"
elif [[ "$profile" == "$own_profile" ]]; then
    echo "FAIL the profile path is right inside the sandbox, but a file GIMP wrote there is not in $own_profile on the host" >&2
    status=1
else
    echo "FAIL expected GIMPhoto's own profile, got '${profile:-nothing}'" >&2
    status=1
fi
missing="$(sed -n 3p "$report")"
if [[ -n "$version" && -z "$missing" ]]; then
    echo "ok   shipped plug-ins registered: ${procedures[*]}"
else
    echo "FAIL plug-in procedures not registered: ${missing:-${procedures[*]}}" >&2
    status=1
fi
# Layer Style effects on an opaque layer without alpha (regression test)
style_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$style_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_layer_style.py').read())" --quit >/dev/null 2>&1 || true
style_result="$(cat "$style_report")"
rm -f "$style_report"
if [[ "$style_result" == ok ]]; then
    echo "ok   layer style draws outside an opaque layer without alpha, with a selection"
else
    echo "FAIL layer style on a layer without alpha: ${style_result:-did not run}" >&2
    status=1
fi
installed_keys="$(flatpak run --command=cat "$app" /app/share/gimp/3.0/gimphoto/shortcutsrc 2>/dev/null || true)"
if [[ -n "$installed_keys" && "$installed_keys" == "$(cat defaults/shortcutsrc)" ]]; then
    echo "ok   default shortcuts installed: Photoshop's"
else
    echo "FAIL /app/share/gimp/3.0/gimphoto/shortcutsrc is missing or not defaults/shortcutsrc" >&2
    status=1
fi
# Gradient / Pattern Overlay: GIMPhoto's GEGL operations and the plug-in
overlays_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$overlays_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_overlays.py').read())" --quit >/dev/null 2>&1 || true
overlays_result="$(cat "$overlays_report")"
rm -f "$overlays_report"
if [[ "$overlays_result" == ok ]]; then
    echo "ok   gradient / pattern overlay (GEGL operations, XCF, Layer Style)"
else
    echo "FAIL gradient / pattern overlay: ${overlays_result:-did not run}" >&2
    status=1
fi
# PSD with editable text, both ways (GIMPhoto's Node and ag-psd)
psd_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$psd_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_psd_text.py').read())" --quit >/dev/null 2>&1 || true
psd_result="$(cat "$psd_report")"
rm -f "$psd_report"
if [[ "$psd_result" == ok ]]; then
    echo "ok   PSD keeps text editable both ways (Type layer + Layer Style)"
else
    echo "FAIL PSD with editable text: ${psd_result:-did not run}" >&2
    status=1
fi
# Layer via Copy / Cut (Ctrl+J / Ctrl+Shift+J) with and without a selection
via_report="$(mktemp /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMPHOTO_SMOKE_OUT="$via_report" "$app" -i --batch-interpreter=python-fu-eval \
    -b "exec(open('$PWD/tests/smoke_layer_via.py').read())" --quit >/dev/null 2>&1 || true
via_result="$(cat "$via_report")"
rm -f "$via_report"
if [[ "$via_result" == ok ]]; then
    echo "ok   layer via copy / cut"
else
    echo "FAIL layer via copy / cut: ${via_result:-did not run}" >&2
    status=1
fi
if flatpak run --command=sh "$app" -c 'grep -q gimp-shape-rectangle-tool /app/bin/gimp-3.*' 2>/dev/null; then
    echo "ok   shape tools compiled in"
else
    echo "FAIL the shape tools (gimp-shape-rectangle-tool...) are not in GIMP" >&2
    status=1
fi
# Photoshop-style defaults (toolbox, layout, settings) and branding
defaults_ok=true
for f in sessionrc toolrc; do
    if [[ "$(flatpak run --command=cat "$app" "/app/etc/gimp/3.0/$f" 2>/dev/null)" != "$(cat "defaults/$f")" ]]; then
        echo "FAIL /app/etc/gimp/3.0/$f is not defaults/$f" >&2
        defaults_ok=false
    fi
done
fresh="$(mktemp -d /tmp/gimphoto-smoke.XXXXXX)"
flatpak run --env=GIMP3_DIRECTORY="$fresh" "$app" -i -d --batch-interpreter=python-fu-eval \
    -b "open('$fresh/answer', 'w').write(Gimp.gimprc_query('layer-preview-size') + ' ' + Gimp.gimprc_query('import-add-alpha') + ' ' + Gimp.gimprc_query('theme'))" \
    --quit >/dev/null 2>&1 || true
answer="$(cat "$fresh/answer" 2>/dev/null || true)"
rm -rf "$fresh"
if [[ "$answer" != "extra-large yes Photoshop" ]]; then
    echo "FAIL a new profile does not get GIMPhoto's gimprc settings (got '${answer:-nothing}')" >&2
    defaults_ok=false
fi
if [[ "$(flatpak run --command=cat "$app" /app/share/gimp/3.0/themes/Photoshop/gimp-dark.css 2>/dev/null)" != "$(cat themes/Photoshop/gimp.css)" ]]; then
    echo "FAIL the Photoshop theme is not installed from themes/Photoshop/gimp.css" >&2
    defaults_ok=false
fi
if ! flatpak run --command=cat "$app" /app/share/gimp/3.0/images/gimp-splash.png 2>/dev/null | cmp -s - branding/splash.png; then
    echo "FAIL the splash screen is not branding/splash.png" >&2
    defaults_ok=false
fi
icon="$(flatpak info --user --show-location "$app")/export/share/icons/hicolor/256x256/apps/$app.png"
if ! cmp -s "$icon" branding/icons/256.png; then
    echo "FAIL the launcher icon is not branding/icons/256.png" >&2
    defaults_ok=false
fi
if [[ "$defaults_ok" == true ]]; then
    echo "ok   Photoshop-style toolbox, layout, theme and settings for new profiles; GIMPhoto splash and icon"
else
    status=1
fi
desktop="$(flatpak run --command=cat "$app" "/app/share/applications/$app.desktop" 2>/dev/null || true)"
if grep -qx "Name=GIMPhoto" <<<"$desktop"; then
    echo "ok   launcher name: GIMPhoto"
else
    echo "FAIL launcher is not named GIMPhoto" >&2
    status=1
fi
launcher="$(flatpak info --user --show-location "$app")/export/share/applications/$app.desktop"
exec_bin="$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$launcher" 2>/dev/null | head -1)"
if [[ -n "$exec_bin" && -x "$exec_bin" ]]; then
    echo "ok   launcher runs $exec_bin (shown in the applications menu)"
else
    echo "FAIL launcher runs '${exec_bin:-nothing}', which this system does not have: the menu hides it" >&2
    status=1
fi
exit $status
