{
  "name": "gimphoto-site",
  "private": true,
  "description": "GIMPhoto's website (Next.js, exported as static files for GitHub Pages)",
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "predev": "npm run assets",
    "dev": "next dev -p 4310",
    "prebuild": "npm run assets",
    "build": "next build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
